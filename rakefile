def create_default_reference_docx(path, overwrite = false, styles_file = ".docx_styles.yaml")
  return if File.exist?(path) && !overwrite

  styles = load_docx_styles(styles_file)

  Dir.mktmpdir("reference_docx") do |dir|
    FileUtils.mkdir_p(File.join(dir, "_rels"))
    FileUtils.mkdir_p(File.join(dir, "word", "_rels"))
    File.write(File.join(dir, "[Content_Types].xml"), default_reference_content_types_xml)
    File.write(File.join(dir, "_rels", ".rels"), default_reference_root_rels_xml)
    File.write(File.join(dir, "word", "document.xml"), default_reference_document_xml(styles))
    File.write(File.join(dir, "word", "styles.xml"), default_reference_styles_xml(styles))
    File.write(File.join(dir, "word", "settings.xml"), default_reference_settings_xml(styles))
    File.write(File.join(dir, "word", "header1.xml"), default_reference_header_xml(styles)) if docx_page_numbers_in_header?(styles)
    if docx_page_numbers_in_footer?(styles)
      page_numbers = styles.fetch("page_numbers", {})
      File.write(File.join(dir, "word", "footer1.xml"), default_reference_footer_xml(styles, page_numbers.fetch("odd_align", page_numbers.fetch("align", "right"))))
      File.write(File.join(dir, "word", "footer2.xml"), default_reference_footer_xml(styles, page_numbers.fetch("even_align", "left")))
    end
    File.write(File.join(dir, "word", "_rels", "document.xml.rels"), default_reference_document_rels_xml(styles))

    absolute_path = File.expand_path(path)
    FileUtils.rm_f(absolute_path)
    Dir.chdir(dir) do
      unless system("zip", "-q", "-r", absolute_path, ".")
        warn "*** WARNING: could not create #{path}; zip command failed"
      end
    end
  end
end

desc "create a new .rakefile.yaml"
task :init do
  yaml_file = ".rakefile.yaml"
  if FileTest.exist?(yaml_file)
    puts "*** #{yaml_file} already exists; just edit it"
  end
  File.open(yaml_file, "w") do |file|
    file.write(<<-STRING
---
:target_files:
  - ./story.txt
:title: "title goes here"
:author: "author goes here"
:publisher_name: "#{PUBLISHER_NAME}"
