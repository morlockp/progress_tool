:opening_title: auto # repeat title at story opening: auto (chapterless), true, or false
:scene_markers: dinkus # dinkus (default) or heading
:never_hyphenate: [] # exact words that must not hyphenate in DOCX
:edition_format: print # print (default) or ebook; controls bibliography links
