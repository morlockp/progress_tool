task :clean do |t|
  `rm -f  '##{$target_file}#' '##{$target_file}' 2> /dev/null`
  `rm -f output.txt output.html output.docx *_draft_*.txt *_draft_*.html *_draft_*.docx *~ .\#* \#* 2> /dev/null`
  
  # do the globbing manually to avoid interactions between Ruby `...` and shell stuff
  # that was causing globbing not to work
  
  system("rm", "-f", *Dir.glob("#*#"))  
end

task :outlines do |t|
  subdir = "./notes/outlines/"
  [
    "06c_outline_wyatt.txt" ,
    "13_domestic.txt" ].each do |f|
    infile_name = "#{subdir}#{f}"

    puts "========== #{infile_name}"
    count = 0
    first = true
    File.open(infile_name, "r") do |infile_h|
      
      while (line = infile_h.gets)
        if line.match(/^\*\* /)
          if first
            first = false
          else
            puts "scene = #{count}"
            count = 0
          end
          puts  line
        elsif line.match(/^\s*scene/)
          count += 1
        end
      end
    end
    puts "scene = #{count}"
  end
end

# regression tests for the tool
task :self_test do |t|
  Dir.chdir("test") do
    open("story.txt", "w") { |f| f << <<~ENDSTRING
             ** chapter 1: one
             foo bar baz
             ** chapter 2: two
             foo bar baz foo bar baz
             ** chapter 3: thre
             foo bar baz foo bar baz baz baz baz
             ENDSTRING
    }
    `ln -f -s ../rakefile .`
    `rake init`
	`cp story.txt story.txt_ORIG`
    `rake > output.txt`
    actual = `grep "today's word delta" output.txt`.gsub!(/\n/, "")
    gold = "  | today's word delta: +13   (+15 -2)"
    puts "actual = .#{actual}."
    puts "gold   = .#{gold}."

    if actual == gold
      puts "self-test passed"
    else
      raise "self-test failed"
    end
    `rm ./.rakefile.yaml ./story.txt ./output.txt ./rakefile`
  end
end

task :self_test_no_act_diff do
  old_target_files = $target_files
  Dir.mktmpdir("rakefile-no-act-diff") do |dir|
    Dir.chdir(dir) do
      File.write("story.txt", "** chapter 1: one\nold words here\n")
      system("git", "init", "-q")
      system("git", "add", "story.txt")
      system("git", "-c", "user.email=test@example.com", "-c", "user.name=test", "commit", "-qm", "base")
      File.write("story.txt", "** chapter 1: one\nnew words here now\n")

      $target_files = ["story.txt"]
      actual = diff_word_totals_for_filter({ :chapter_head_tag => "** chapter" }, nil, :all)
      raise "no-act diff test failed: #{actual.inspect}" unless actual[:plus] == 4 && actual[:minus] == 3
    end
  end
ensure
  $target_files = old_target_files
end

task :self_test_inline_style do
  require 'zip'

  html = process_inline_markup_for_html("Normal [[style:RadioVoice]]radio _text_[[/style]] normal")
  expected = %(Normal <span custom-style="RadioVoice">radio <i>text</i></span> normal)
  raise "inline style HTML failed: #{html.inspect}" unless html == expected
  line_html = process_line_markup_for_html("   [D]1234")
  expected_line = %(<span custom-style="DSEG14Classic">1234</span>)
  raise "line style HTML failed: #{line_html.inspect}" unless line_html == expected_line
  rendered = format_interleaved_as_html([
    { :type => :chapter, :text => "** chapter 1: one\nabc\n[D]1234\ndef" }
  ], {})
  raise "line style render failed: #{rendered.inspect}" unless rendered.include?(%(<p>abc <span custom-style="DSEG14Classic">1234</span> def</p>))

  Dir.mktmpdir("rakefile-inline-style") do |dir|
    ref = File.join(dir, "ref.docx")
    input = File.join(dir, "input.html")
    docx = File.join(dir, "out.docx")
    create_default_reference_docx(ref, true)
    File.write(input, "<p>#{html}</p>\n")
    raise "pandoc failed" unless system("pandoc", input, "--reference-doc=#{ref}", "-o", docx)

    Zip::File.open(docx) do |zip|
      enforce_docx_character_styles(zip, {})
    end

    Zip::File.open(docx) do |zip|
      document = zip.find_entry("word/document.xml").get_input_stream.read
      styles = zip.find_entry("word/styles.xml").get_input_stream.read
      raise "DOCX run style missing" unless document.include?(%(<w:rStyle w:val="RadioVoice"))
      raise "DOCX font style missing" unless styles.include?(%(<w:rFonts w:ascii="Courier New"))
    end
  end
end
# Helper: parse chapters and Act lines from a single file
# Returns hash with :chapters and :acts
# chapters: { chapter_num => { :title, :full_text, :source_file, :pragmas } }
# acts: ordered array of { :line => "* Act ...", :before_chapter => chapter_num_or_nil }
def parse_chapters_and_acts_from_file(file_path, config)
  if !File.exist?(file_path)
    warn "*** warning: file #{file_path} not found"
    return { :chapters => {}, :acts => [] }
  end
  
  contents = File.read(file_path)
  parse_chapters_and_acts_from_contents(contents, file_path, config)
end

def target_file_clean_in_git?(file)
  system("git", "ls-files", "--error-unmatch", file, out: File::NULL, err: File::NULL) &&
    system("git", "diff", "--quiet", "--", file) &&
    system("git", "diff", "--cached", "--quiet", "--", file)
end

def renumber_chapters_in_contents(contents, config)
  chapter_head_tag = config[:chapter_head_tag] || "== chapter"
  next_act_start = 1
  next_chapter_num = nil

  contents.lines.map do |line|
    if line.match?(/^\* Act\b/i)
      next_chapter_num = next_act_start
      next_act_start += next_act_start == 1 ? 9 : 10
      line
    elsif line =~ /^(\s*#{Regexp.escape(chapter_head_tag)}\s+)(\d+)/
      next_chapter_num ||= 1
      new_line = line.sub(/^(\s*#{Regexp.escape(chapter_head_tag)}\s+)\d+/, "\\1#{next_chapter_num}")
      next_chapter_num += 1
      next_act_start += 10 while next_act_start <= next_chapter_num
      new_line
    else
      line
    end
  end.join
end

def renumber_chapters_in_file(file, config)
  original = File.read(file)
  updated = renumber_chapters_in_contents(original, config)
  File.write(file, updated) if updated != original
  updated != original
end

desc "Renumber chapters in each source file by act"
task :renumber do
  # dirty_files = $target_files.reject { |file| target_file_clean_in_git?(file) }
  # unless dirty_files.empty?
  #   abort "*** ERROR: refusing to renumber because these source files are not clean in git: #{dirty_files.join(', ')}"
  # end

  $target_files.each do |file|
    abort "*** ERROR: target file #{file} not found" unless File.exist?(file)

    changed = renumber_chapters_in_file(file, config)
    puts "#{changed ? 'Renumbered' : 'Already numbered'} #{file}"
  end
end

def parse_chapters_and_acts_from_contents(contents, file_path, config, line_sources = {})
  if config[:chapterless]
    chapters = contents.strip.empty? ? {} : {
      1 => { :title => config[:title], :full_text => contents, :source_file => file_path,
             :chapterless => true, :pragmas => parse_pragmas_from_chapter_text(contents) }
    }
    return { :chapters => chapters, :acts => [], :leading_xxx_lines => [] }
  end

  chapter_head_tag = config[:chapter_head_tag] || "== chapter"
  lines = contents.split("\n")
  before_first_act = true
  leading_xxx_lines = []
  cleaned_lines = []
  cleaned_line_sources = []
  source_id = extract_source_id(file_path)

  idx = 0
  while idx < lines.size
    line = lines[idx]
    before_first_act = false if line.match?(/^\* Act\b/i)
    if before_first_act && line.match?(/^\s*XXX\b/)
      comment_lines = [line]
      idx += 1
      while idx < lines.size && lines[idx].strip != ""
        comment_lines << lines[idx]
        idx += 1
      end
      leading_xxx_lines << { :line => reflow_xxx_comment(comment_lines), :source_id => source_id, :source_file => file_path }
      next
    end

    cleaned_lines << line
    cleaned_line_sources << (line_sources[idx + 1] || file_path)
    idx += 1
  end

  contents = cleaned_lines.join("\n")
  lines = cleaned_lines
  
  acts = []
  chapters = {}
  current_chapter_num = nil
  last_act_before_chapter = nil
  last_act_before_chapter_lineno = nil
  
  # First pass: extract Act lines and track which chapter comes after
  lines.each_with_index do |line, idx|
    lineno = idx + 1
    if line =~ /^\* / && line !~ /^\*\s+\*\s+\*\s*$/
      # Line starts with single asterisk
      if line !~ /^\* Act /i
        bytes = line.bytes.map { |b| sprintf("%02x", b) }.join(' ')
        source_path = cleaned_line_sources[idx] || file_path
        if line =~ /chapter/i
          abort "*** SYNTAX ERROR in #{source_path}: Line #{lineno}: starts with '*' but not followed by 'Act': #{line.inspect}\n  bytes: #{bytes}\n  Hint: did you forget an extra asterisk for the chapter?"
        else
          abort "*** SYNTAX ERROR in #{source_path}: Line #{lineno}: starts with '*' but not followed by 'Act': #{line.inspect}\n  bytes: #{bytes}"
        end
      end
      # Valid Act line - will be associated with the next chapter we see
      last_act_before_chapter = line
      last_act_before_chapter_lineno = lineno
    elsif line =~ /^#{Regexp.escape(chapter_head_tag)}\s/
      # Extract chapter number
      line.match(/ (\d+)/)
      if $1
        current_chapter_num = $1.to_i
        # If we have an act waiting, associate it with this chapter
        if last_act_before_chapter
          acts << { :line => last_act_before_chapter, :before_chapter => current_chapter_num, :line_no => last_act_before_chapter_lineno }
          last_act_before_chapter = nil
          last_act_before_chapter_lineno = nil
        end
      end
    end
  end
  
  # Second pass: parse chapters (excluding Act lines from content)
  arr = contents.split(chapter_head_tag)
  arr = arr.slice(1..9999)
  arr ||= []
  
  arr.each do |text|
    lines = text.split("\n")
    title_line = lines[0]
    
    # Extract chapter number
    title_line.match(/ (\d+)/)
    chapter_num_str = $1
    
    next unless chapter_num_str
    
    chap_num = chapter_num_str.to_i
    
    # Remove Act lines from chapter content
    content_lines = lines.reject { |l| l =~ /^\* Act /i }
    clean_text = content_lines.join("\n")
    
    # Reconstruct chapter text
    full_text = "#{chapter_head_tag}#{clean_text}"
    
    # Parse pragmas from chapter text
    pragmas = parse_pragmas_from_chapter_text(full_text)
    
    chapters[chap_num] = {
      :title => title_line,
      :full_text => full_text,
      :source_file => file_path,
      :pragmas => pragmas
    }
  end
  
  { :chapters => chapters, :acts => acts, :leading_xxx_lines => leading_xxx_lines }
end

# Helper to extract source identifier from filename (e.g., "lopez" from "story_lopez.txt")
def extract_source_id(filename)
  # Remove leading path, extract part after last underscore and before extension
  basename = File.basename(filename)
  if basename =~ /^.*?_(.+?)\.\w+$/
    $1.upcase
  else
    basename.upcase
  end
end

def label_leading_xxx_line(line, source_id)
  line.sub(/^(\s*)XXX\b/, "\\1XXX #{source_id}")
end

def reflow_xxx_comment(lines)
  lines.map(&:strip).reject(&:empty?).join(" ").gsub(/\s+/, " ")
end

# Parse pragmas from chapter text
# Returns hash with :defines (string or nil), :depends_on (array of strings), and :must_come_before (array of strings)
def parse_pragmas_from_chapter_text(chapter_text)
  defines = nil
  depends_on = []
  must_come_before = []
  
  chapter_text.each_line do |line|
    # Look for DEFINE-TAG pragma
    if line =~ /^\s*#\s*DEFINE-TAG:\s*(\S+)/
      defines = $1
    end
    
    # Look for MUST-BE-AFTER pragma(s) - can have multiple occurrences
    if line =~ /^\s*#\s*MUST-BE-AFTER:\s*(.+)/
      deps_str = $1
      # Split by comma, strip whitespace from each
      deps_str.split(',').each do |dep|
        dep_tag = dep.strip
        depends_on << dep_tag if dep_tag != ""
      end
    end
    
    # Look for MUST-BE-BEFORE pragma(s) - can have multiple occurrences
    if line =~ /^\s*#\s*MUST-BE-BEFORE:\s*(.+)/
      before_str = $1
      # Split by comma, strip whitespace from each
      before_str.split(',').each do |tag|
        tag_name = tag.strip
        must_come_before << tag_name if tag_name != ""
      end
    end
  end
  
  { :defines => defines, :depends_on => depends_on, :must_come_before => must_come_before }
end

# Build global pragma registry from all files
# Returns hash with validation status and mappings
def build_pragma_registry(all_data, all_files)
  tag_definitions = {}        # tag_name => "file:chapter_num"
  chapter_dependencies = {}   # "file:chapter_num" => [tag1, tag2, ...] (MUST-BE-AFTER)
  chapter_must_come_before = {} # "file:chapter_num" => [tag1, tag2, ...] (MUST-BE-BEFORE)
  undefined_tags = Set.new
  unused_tags = Set.new
  circular_deps = []
  
  # First pass: collect all DEFINE-TAG pragmas
  all_files.each do |file|
    next unless all_data[file]
    
    all_data[file][:chapters].each do |local_ch_num, chapter_data|
      pragmas = chapter_data[:pragmas] || { :defines => nil, :depends_on => [] }
      
      if pragmas[:defines]
        tag_name = pragmas[:defines]
        chapter_id = "#{file}:#{local_ch_num}"
        
        if tag_definitions[tag_name]
          # Tag redefined - warn or error
          abort "*** ERROR: Tag '#{tag_name}' defined multiple times: in #{tag_definitions[tag_name]} and #{chapter_id}"
        end
        
        tag_definitions[tag_name] = chapter_id
        unused_tags.add(tag_name)  # Start with all tags as unused; we'll mark them used below
      end
    end
  end
  
  # Second pass: collect all MUST-BE-AFTER and MUST-BE-BEFORE dependencies and mark tags as used
  all_files.each do |file|
    next unless all_data[file]
    
    all_data[file][:chapters].each do |local_ch_num, chapter_data|
      pragmas = chapter_data[:pragmas] || { :defines => nil, :depends_on => [], :must_come_before => [] }
      
      chapter_id = "#{file}:#{local_ch_num}"
      
      # Handle MUST-BE-AFTER dependencies
      if pragmas[:depends_on].size > 0
        chapter_dependencies[chapter_id] = pragmas[:depends_on].dup
        
        # Check for undefined tags and mark defined tags as used
        pragmas[:depends_on].each do |tag|
          if tag_definitions[tag]
            unused_tags.delete(tag)
          else
            undefined_tags.add(tag)
          end
        end
      end
      
      # Handle MUST-BE-BEFORE dependencies
      if pragmas[:must_come_before].size > 0
        chapter_must_come_before[chapter_id] = pragmas[:must_come_before].dup
        
        # Check for undefined tags and mark defined tags as used
        pragmas[:must_come_before].each do |tag|
          if tag_definitions[tag]
            unused_tags.delete(tag)
          else
            undefined_tags.add(tag)
          end
        end
      end
    end
  end
  
  # Detect circular dependencies using DFS
  visited = Set.new
  rec_stack = Set.new
  
  def has_cycle_dfs(chapter_id, graph, visited, rec_stack, tag_definitions)
    visited.add(chapter_id)
    rec_stack.add(chapter_id)
    
    deps = graph[chapter_id] || []
    deps.each do |tag|
      dep_chapter_id = tag_definitions[tag]
      next unless dep_chapter_id  # Skip undefined tags (already recorded)
      
      if !visited.include?(dep_chapter_id)
        if has_cycle_dfs(dep_chapter_id, graph, visited, rec_stack, tag_definitions)
          return true
        end
      elsif rec_stack.include?(dep_chapter_id)
        # Found a cycle
        return true
      end
    end
    
    rec_stack.delete(chapter_id)
    false
  end
  
  chapter_dependencies.keys.each do |chapter_id|
    if !visited.include?(chapter_id)
      if has_cycle_dfs(chapter_id, chapter_dependencies, visited, rec_stack, tag_definitions)
        circular_deps << chapter_id
      end
    end
  end
  
  {
    :tag_definitions => tag_definitions,
    :chapter_dependencies => chapter_dependencies,
    :chapter_must_come_before => chapter_must_come_before,
    :undefined_tags => undefined_tags.to_a,
    :unused_tags => unused_tags.to_a,
    :circular_deps => circular_deps
  }
end

# Perform topological sort on chapters respecting pragma dependencies
# Returns ordered array of chapter IDs ("file:local_ch_num")
def topological_sort_chapters(chapter_dependencies, chapter_must_come_before, tag_definitions, all_chapters_by_id, source_order_sequences = [], chapter_act_order = {})
  # Build in-degree map and adjacency list for topological sort
  in_degree = {}
  adjacency = {}
  
  all_chapters_by_id.each do |chapter_id|
    in_degree[chapter_id] = 0
    adjacency[chapter_id] = []
  end

  add_topological_edge = lambda do |before_id, after_id|
    next unless in_degree.key?(before_id) && in_degree.key?(after_id)
    adjacency[before_id] ||= []
    next if adjacency[before_id].include?(after_id)

    adjacency[before_id] << after_id
    in_degree[after_id] = (in_degree[after_id] || 0) + 1
  end
  
  # Handle MUST-BE-AFTER dependencies (this chapter depends on tagged chapters)
  chapter_dependencies.each do |chapter_id, dep_tags|
    dep_tags.each do |tag|
      dep_chapter_id = tag_definitions[tag]
      next unless dep_chapter_id
      
      # dep_chapter_id must come before chapter_id
      add_topological_edge.call(dep_chapter_id, chapter_id)
    end
  end
  
  # Handle MUST-BE-BEFORE dependencies (tagged chapters depend on this chapter)
  chapter_must_come_before.each do |chapter_id, before_tags|
    before_tags.each do |tag|
      before_chapter_id = tag_definitions[tag]
      next unless before_chapter_id
      
      # chapter_id must come before before_chapter_id
      add_topological_edge.call(chapter_id, before_chapter_id)
    end
  end

  # A chapter from a source thread must never jump ahead of an earlier chapter
  # from that same source file when pragma sorting is applied.
  source_order_sequences.each do |chapter_ids|
    chapter_ids.each_cons(2) do |before_id, after_id|
      add_topological_edge.call(before_id, after_id)
    end
  end

  all_chapters_by_id.each do |before_id|
    before_act_order = chapter_act_order[before_id]
    next if before_act_order.nil?

    all_chapters_by_id.each do |after_id|
      after_act_order = chapter_act_order[after_id]
      next if after_act_order.nil?
      next unless before_act_order < after_act_order

      add_topological_edge.call(before_id, after_id)
    end
  end
  
  # Kahn's algorithm for topological sort
  queue = []
  in_degree.each do |chapter_id, degree|
    queue << chapter_id if degree == 0
  end
  
  sorted = []
  while queue.size > 0
    current = queue.shift
    sorted << current
    
    (adjacency[current] || []).each do |neighbor|
      in_degree[neighbor] -= 1
      queue << neighbor if in_degree[neighbor] == 0
    end
  end
  
  # Check if all chapters were sorted (if not, there's a cycle we missed)
  if sorted.size != all_chapters_by_id.size
    abort "*** ERROR: Topological sort failed - cycle detected in pragma dependencies"
  end
  
  sorted
end

def source_order_sequences_for(all_data, target_files)
  target_files.map do |file|
    next [] unless all_data[file]

    all_data[file][:chapters].keys.map { |local_ch_num| "#{file}:#{local_ch_num}" }
  end
end

def act_order_index_for(all_acts, target_files)
  act_order = {}

  target_files.each do |file|
    (all_acts[file] || []).each do |act_data|
      act_id = act_id_from_line(act_data[:line])
      next unless act_id
      next if act_order.key?(act_id)

      act_order[act_id] = act_order.size
    end
  end

  act_order
end

def chapter_act_order_for(all_data, all_acts, target_files)
  act_order = act_order_index_for(all_acts, target_files)
  ret = {}

  target_files.each do |file|
    next unless all_data[file]

    all_data[file][:chapters].each_key do |local_ch_num|
      act_id = chapter_act_id(local_ch_num, all_acts[file] || [])
      ret["#{file}:#{local_ch_num}"] = act_order[act_id]
    end
  end

  ret
end

def acts_by_chapter_id(all_acts, target_files)
  ret = Hash.new { |h, k| h[k] = [] }

  target_files.each do |file|
    (all_acts[file] || []).each do |act_data|
      next unless act_data[:before_chapter]

      ret["#{file}:#{act_data[:before_chapter]}"] << act_data
    end
  end

  ret
end

# Shared function to parse all chapters and Acts, and validate structure
def build_interleaved_data(all_data, all_acts, max_chapter, pragma_registry = nil)
  # Validate that Act lines are identical across all files (up to the minimum count)
  # It is acceptable for one file to have fewer Acts at the end than another
  if all_acts.values.length > 1
    first_file_acts = all_acts[$target_files[0]]
    $target_files[1..-1].each do |file|
      file_acts = all_acts[file]
      
      # Only validate Acts up to the minimum count between the two files
      min_acts = [first_file_acts.length, file_acts.length].min
      
      min_acts.times do |idx|
        if first_file_acts[idx][:line] != file_acts[idx][:line]
          first_lineno = first_file_acts[idx][:line_no] || "unknown"
          second_lineno = file_acts[idx][:line_no] || "unknown"
          abort "*** SYNTAX ERROR: Act line differs between #{$target_files[0]} (line #{first_lineno}) and #{file} (line #{second_lineno}): \n  #{$target_files[0]}: #{first_file_acts[idx][:line]}\n  #{file}: #{file_acts[idx][:line]}"
        end
      end
    end
  end

  # Build list of all chapters in "file:chapter_num" format
  all_chapters = []
  (1..max_chapter).each do |local_ch_num|
    $target_files.each do |file|
      if all_data[file][:chapters][local_ch_num]
        all_chapters << "#{file}:#{local_ch_num}"
      end
    end
  end
  
  sorted_chapters = topological_sort_chapters(
    pragma_registry ? pragma_registry[:chapter_dependencies] : {},
    pragma_registry ? pragma_registry[:chapter_must_come_before] : {},
    pragma_registry ? pragma_registry[:tag_definitions] : {},
    all_chapters,
    source_order_sequences_for(all_data, $target_files),
    chapter_act_order_for(all_data, all_acts, $target_files)
  )
  
  # Build interleaved structure with pragmas-respecting chapter order
  # Output Acts when we reach the chapter that follows the marker in any source file.
  interleaved = []
  sequential_chapter_num = 0
  act_markers_by_chapter_id = acts_by_chapter_id(all_acts, $target_files)
  seen_act_lines = Set.new

  sorted_chapters.each do |chapter_id|
    file, local_ch_num_str = chapter_id.split(':')
    local_ch_num = local_ch_num_str.to_i

    act_markers_by_chapter_id[chapter_id].each do |act_data|
      next if seen_act_lines.include?(act_data[:line])

      interleaved << { :type => :act, :line => act_data[:line], :source_file => file }
      seen_act_lines.add(act_data[:line])
    end
    
    sequential_chapter_num += 1
    chapter_data = all_data[file][:chapters][local_ch_num]
    source_id = extract_source_id(file)

    # Augment the chapter header with source identifier/original chapter and renumber to sequential
    augmented_text = chapter_data[:full_text].dup
    augmented_text.sub!(/^(\*\*\s*chapter\s+)(\d+)([^:\n]*:)/i) do
      source_label = $target_files.size > 1 ? " (#{source_id} #{$2})" : ""
      "#{$1}#{sequential_chapter_num}#{source_label}#{$3}"
    end

    interleaved << { :type => :chapter, :text => augmented_text, :chapterless => chapter_data[:chapterless], :chapter_id => chapter_id, :sequential_num => sequential_chapter_num, :source_file => file }
  end

  interleaved
end

# Validate pragma constraints in the interleaved output
# Reports each constraint and whether it was satisfied
def validate_pragma_constraints_in_output(interleaved, pragma_registry, all_data, target_files)
  # Build mapping: chapter_id => sequential_number in output
  chapter_positions = {}
  interleaved.each do |item|
    if item[:type] == :chapter && item[:chapter_id]
      chapter_positions[item[:chapter_id]] = item[:sequential_num]
    end
  end

  failures = []
  
  # Check all pragmas
  target_files.each do |file|
    all_data[file][:chapters].each do |local_ch_num, chapter_data|
      pragmas = chapter_data[:pragmas] || { :defines => nil, :depends_on => [] }
      chapter_id = "#{file}:#{local_ch_num}"
      seq_num = chapter_positions[chapter_id]
      
      next unless seq_num  # Chapter not in output
      
      # Report DEFINE-TAG pragmas
      if pragmas[:defines]
        puts "  * chapter #{seq_num}: tag '#{pragmas[:defines]}' ; defined"
      end
      
      # Check MUST-BE-AFTER constraints
      pragmas[:depends_on].each do |tag|
        dep_chapter_id = pragma_registry[:tag_definitions][tag]
        
        unless dep_chapter_id
          # Tag undefined - already reported earlier
          next
        end
        
        dep_seq_num = chapter_positions[dep_chapter_id]
        
        if dep_seq_num && dep_seq_num < seq_num
          puts "  * chapter #{seq_num}: MUST-BE-AFTER '#{tag}' - ✓ satisfied (#{tag} at chapter #{dep_seq_num})"
        else
          puts "  * chapter #{seq_num}: MUST-BE-AFTER '#{tag}' - ✗ FAILED (#{tag} not before this chapter)"
          failures << "Chapter #{seq_num} depends on '#{tag}' but it's not positioned before it"
        end
      end
      
      # Check MUST-BE-BEFORE constraints
      (pragmas[:must_come_before] || []).each do |tag|
        before_chapter_id = pragma_registry[:tag_definitions][tag]
        
        unless before_chapter_id
          # Tag undefined - already reported earlier
          next
        end
        
        before_seq_num = chapter_positions[before_chapter_id]
        
        if before_seq_num && seq_num < before_seq_num
          puts "  * chapter #{seq_num}: MUST-BE-BEFORE '#{tag}' - ✓ satisfied (#{tag} at chapter #{before_seq_num})"
        else
          puts "  * chapter #{seq_num}: MUST-BE-BEFORE '#{tag}' - ✗ FAILED (#{tag} not after this chapter)"
          failures << "Chapter #{seq_num} must come before '#{tag}' but it's not positioned before it"
        end
      end
    end
  end
  
  if failures.size > 0
    puts ""
    puts "  *** CONSTRAINT VIOLATIONS DETECTED ***"
    failures.each { |f| puts "  *** #{f}" }
    abort "Pragma constraints not satisfied in output"
  end

  # Warn about unused tags (defined but never referenced)
  if pragma_registry[:unused_tags] && !pragma_registry[:unused_tags].empty?
    puts ""
    puts "  *** WARNING: The following tags are defined but never referenced in any MUST-BE-AFTER or MUST-BE-BEFORE pragma:"
    pragma_registry[:unused_tags].each do |tag|
      chapter_id = pragma_registry[:tag_definitions][tag]
      puts "    - tag '#{tag}' defined in #{chapter_id}"
    end
  end
end

# Process underscores for italics, converting _text_ to <i>text</i>
# Validates that italics don't have unintended underscores mid-alphanumeric.
def process_italics_for_html(text)
  result = ""
  i = 0
  
  while i < text.length
    # Look for opening underscore
    if text[i] == '_'
      # Check if this is a middle underscore (between alphanumerics)
      prev_char = i > 0 ? text[i-1] : nil
      next_char = i < text.length - 1 ? text[i+1] : nil
      
      if prev_char&.match?(/[a-zA-Z0-9]/) && next_char&.match?(/[a-zA-Z0-9]/)
        # Middle underscore like in "file_1.txt" is literal text, not italics.
        result += text[i]
        i += 1
        next
      end
      
      # Try to find closing underscore
      close_idx = text.index('_', i + 1)
      
      if close_idx.nil?
        # No closing underscore found - just keep the opening one
        result += text[i]
        i += 1
      else
        # Extract italicized content
        italic_content = text[i+1...close_idx]
        
        # Convert to HTML italic tag
        result += "<i>#{CGI.escapeHTML(italic_content)}</i>"
        i = close_idx + 1
      end
    else
      result += text[i]
      i += 1
    end
  end
  
  result
end

def process_bold_for_html(text)
  text.gsub(/\*\*(?=\S)([^*]*?)(?<=\S)\*\*/, '<b>\1</b>')
end

def apply_never_hyphenate_words(text, config)
  words = Array(config && (config[:never_hyphenate] || config["never_hyphenate"])).map(&:to_s).reject(&:empty?).uniq
  words.sort_by { |word| -word.length }.each do |word|
    text = text.gsub(/(?<![\p{L}\p{N}_])#{Regexp.escape(word)}(?![\p{L}\p{N}_])/u) { |match| match.chars.join("\u2060") }
  end
  text
end

def character_style_marker_map(config)
  styles = load_docx_styles(docx_styles_file(config || {}))
  (styles["character_styles"] || {}).each_with_object({}) do |(style_id, style), markers|
    marker = style["marker"]
    markers[marker.to_s] = style_id.to_s if marker && marker.to_s != ""
  end
end

def process_inline_markup_for_html(text, config = nil)
  apply_never_hyphenate_words(text.to_s, config).gsub(/\[\[style:([A-Za-z][A-Za-z0-9_-]*)\]\](.*?)\[\[\/style\]\]/m) do
    style_id = CGI.escapeHTML($1)
    content = process_inline_markup_for_html($2, config)
    %(<span custom-style="#{style_id}">#{content}</span>)
  end.then { |html| process_italics_for_html(html) }
     .then { |html| process_bold_for_html(html) }
end

def process_line_markup_for_html(line, config = nil)
  stripped = line.to_s.lstrip
  character_style_marker_map(config).sort_by { |marker, _style_id| -marker.length }.each do |marker, style_id|
    next unless stripped.start_with?(marker)

    content = stripped[marker.length..-1].to_s
    return %(<span custom-style="#{CGI.escapeHTML(style_id)}">#{process_inline_markup_for_html(content, config)}</span>)
  end

  process_inline_markup_for_html(line, config)
end

## Helper: Remove arrows like <==, <===, <====, etc. from text
def remove_arrows(text)
  # Remove any arrows like <==, <===, <====, etc. at the start of lines or inline
  text.gsub(/<={2,}/, "")
end

def frontmatter_files(config)
  configured = config[:frontmatter] || config["frontmatter"] || config[:front_matter] || config["front_matter"]
  legacy_entries = Array(configured).compact
  toc_entries = legacy_entries.select { |entry| frontmatter_toc_marker?(entry) }
  epigraph = config[:epigraph] || config["epigraph"]
  standard_entries = []
  standard_entries << epigraph unless epigraph.to_s.strip.empty?
  timeline = config[:timeline] || config["timeline"]
  dramatis = config[:dramatis_personae] || config["dramatis_personae"]
  kickstarter_backers = config[:kickstarter_backers] || config["kickstarter_backers"]
  standard_entries << { "file" => timeline, "style" => "timeline" } unless timeline.to_s.strip.empty?
  standard_entries << { "file" => dramatis, "style" => "dramatis" } unless dramatis.to_s.strip.empty?
  standard_entries << kickstarter_backers unless kickstarter_backers.to_s.strip.empty?
  return legacy_entries if standard_entries.empty? && !(config[:toc] || config["toc"])

  return legacy_entries if standard_entries.empty? && toc_entries.any?
  return legacy_entries + [:TOC] if standard_entries.empty?

  toc_entries << :TOC if (config[:toc] || config["toc"]) && toc_entries.empty?

  standard_entries + legacy_entries.reject { |entry| frontmatter_toc_marker?(entry) } + toc_entries
end

def ebook_toc?(config)
  config && (config[:toc] || config["toc"]).to_s == "ebook"
end

def full_frontmatter_layout?(config)
  value = config && (config[:frontmatter_layout] || config["frontmatter_layout"])
  !value.to_s.casecmp("condensed").zero?
end

def dedication_html(config)
  file = frontmatter_entry_file(config[:dedication] || config["dedication"])
  return "" if file.to_s.strip.empty? || !File.file?(file)

  contents = read_frontmatter_file(file)
  return "" if contents.strip.empty?

  html = matter_file_to_html(file, config)
  ["<p>DOCX_DEDICATION_START</p>", html.strip].join("\n") + "\n"
end

def other_books_files(config)
  configured = config[:other_books] || config["other_books"]
  Array(configured).compact
end

def universe_catalog(config)
  path = config[:more_in_this_universe] || config["more_in_this_universe"]
  return nil if path.to_s.strip.empty?

  data = stringify_yaml_keys(load_rakefile_config(path))
  unless data.is_a?(Hash) && data["books"].is_a?(Array) && !data["heading"].to_s.strip.empty?
    abort "*** ERROR: universe catalog needs a heading and a books list: #{path}"
  end
  ids = []
  data["books"].each do |book|
    unless book.is_a?(Hash) && %w[id title].all? { |key| !book[key].to_s.strip.empty? }
      abort "*** ERROR: each universe catalog book needs id and title"
    end
    abort "*** ERROR: duplicate universe book id #{book['id']}" if ids.include?(book["id"])
    ids << book["id"]
    url = book["amazon_url"].to_s.strip
    next if url.empty?
    begin
      uri = URI.parse(url)
      valid = uri.is_a?(URI::HTTP) && uri.host.to_s.match?(/\A(?:[a-z0-9-]+\.)*amazon\.com\z/i)
    rescue URI::InvalidURIError
      valid = false
    end
    abort "*** ERROR: invalid Amazon URL for #{book['id']}" unless valid
  end
  current_id = config[:book_id] || config["book_id"]
  abort "*** ERROR: :book_id must match a book in #{path}" unless ids.include?(current_id)
  data.merge("books" => data["books"].reject { |book| book["id"] == current_id })
end

def reader_action_url(url, field, amazon_only: false)
  url = url.to_s.strip
  return "" if url.empty?

  begin
    uri = URI.parse(url)
    valid = uri.is_a?(URI::HTTP) && !uri.host.to_s.empty? && uri.userinfo.nil?
    valid &&= uri.host.to_s.match?(/\A(?:[a-z0-9-]+\.)*amazon\.com\z/i) if amazon_only
  rescue URI::InvalidURIError
    valid = false
  end
  requirement = amazon_only ? "Amazon.com HTTP(S)" : "HTTP(S)"
  abort "*** ERROR: #{field} must be an absolute #{requirement} URL" unless valid
  url
end

def reader_review(config)
  url = config[:reader_review_url] || config["reader_review_url"]
  asin = (config[:reader_review_asin] || config["reader_review_asin"]).to_s.strip
  unless asin.empty?
    abort "*** ERROR: :reader_review_asin must be 10 uppercase letters or digits" unless asin.match?(/\A[A-Z0-9]{10}\z/)
    abort "*** ERROR: set only one of :reader_review_asin and :reader_review_url" unless url.to_s.strip.empty?
    url = "https://www.amazon.com/review/create-review/?#{URI.encode_www_form(asin: asin)}"
  end
  url = reader_action_url(url, ":reader_review_url", amazon_only: true)
  return nil if url.empty?

  title = config[:title] || config["title"] || $title
  {
    title: "Rate #{title} on Amazon",
    description: "Please leave an honest star rating on Amazon. If you’d like to say more, a sentence or two helps other readers decide whether this book is for them.",
    url: url
  }
end

def reader_action_settings(config)
  settings = config[:reader_actions] || config["reader_actions"]
  settings = load_rakefile_config(settings) if settings.is_a?(String)
  settings = {} if settings.nil?
  abort "*** ERROR: :reader_actions must be a YAML file or mapping" unless settings.is_a?(Hash)
  settings = stringify_yaml_keys(settings)
  unknown = settings.keys - %w[patreon_url catalog_url]
  abort "*** ERROR: unknown :reader_actions fields: #{unknown.join(', ')}" unless unknown.empty?
  settings["patreon_url"] = reader_action_url(settings["patreon_url"], ":reader_actions.patreon_url")
  settings["catalog_url"] = reader_action_url(settings["catalog_url"], ":reader_actions.catalog_url", amazon_only: true)
  settings
end

def reader_action_sections(config)
  settings = reader_action_settings(config)
  lead = (config[:reader_actions_lead] || config["reader_actions_lead"] || "books").to_s
  abort "*** ERROR: :reader_actions_lead must be books or patreon" unless %w[books patreon].include?(lead)

  sections = []
  catalog = universe_catalog(config)
  if catalog && catalog["books"].any?
    sections << { id: :universe, heading: catalog["heading"], intro: catalog["intro"],
                  items: catalog["books"].map { |b| { title: b["title"], description: b["description"], url: b["amazon_url"] } } }
  end
  patreon = settings["patreon_url"]
  unless patreon.empty?
    section = { id: :patreon, heading: "Read new chapters free", items: [{
      title: "Follow me free on Patreon", url: patreon,
      description: "Get new chapters of my work in progress by joining me on Patreon for free. No paid membership is needed to read the free chapters."
    }] }
    sections << section
  end
  review = reader_review(config)
  sections << { id: :review, heading: "What did you think?", items: [review] } if review
  # Keep the two requests together when Stay connected leads the backmatter.
  sections = sections.reject { |s| s[:id] == :universe } + sections.select { |s| s[:id] == :universe } if lead == "patreon"
  sections
end

def reader_actions_text(config)
  connected = false
  lines = reader_action_sections(config).flat_map do |section|
    group_heading = connected || section[:id] == :universe ? nil : "Stay connected"
    connected = true if group_heading
    [group_heading, section[:heading], section[:intro]] + section[:items].map do |item|
      [item[:title], item[:description], item[:url]].compact.reject { |v| v.to_s.strip.empty? }.join("\n")
    end
  end
  lines = lines.compact.reject { |v| v.to_s.strip.empty? }
  lines.empty? ? "" : lines.join("\n\n") + "\n\n"
end

def reader_action_item_html(item, format)
  title = CGI.escapeHTML(item[:title].to_s)
  description = CGI.escapeHTML(item[:description].to_s)
  url = item[:url].to_s.strip
  label = "<strong>#{title}</strong>"
  if url.empty?
    return "<p>#{label}#{description.empty? ? '' : '<br />' + description}</p>"
  end
  escaped_url = CGI.escapeHTML(url)
  if format == "ebook"
    "<p><a href=\"#{escaped_url}\"><u>#{label}</u></a>#{description.empty? ? '' : '<br />' + description}</p>"
  else
    # One paragraph keeps the QR code, its purpose, and fallback address together.
    %(<p>#{label}#{description.empty? ? '' : '<br />' + description}<br /><img src="#{matter_qr_code_data_uri(url)}" alt="QR code: #{title}" style="width: 0.75in; height: 0.75in;" /><br />#{escaped_url}</p>)
  end
end

def reader_actions_html(config, page_breaks = false)
  sections = reader_action_sections(config)
  return "" if sections.empty?

  format = edition_format(config)
  html = []
  sections.each_with_index do |section, index|
    new_page = index.zero? || section[:id] == :universe || sections[index - 1][:id] == :universe
    if new_page && page_breaks
      html << "<p>DOCX_ABOUT_AUTHOR_END</p>" unless index.zero?
      html << "<p>DOCX_AFTERMATTER_PAGE_BREAK_reader_#{index}</p>" << "<p>DOCX_ABOUT_AUTHOR_START_READER_ACTIONS</p>"
    end
    heading = CGI.escapeHTML(section[:heading].to_s)
    if section[:id] == :universe
      html << "<h1>#{heading}</h1>"
    else
      html << "<h1>Stay connected</h1>" if new_page
      html << "<h2>#{heading}</h2>"
    end
    html << "<p>#{CGI.escapeHTML(section[:intro].to_s)}</p>" unless section[:intro].to_s.strip.empty?
    html.concat(section[:items].map { |item| reader_action_item_html(item, format) })
  end
  html << "<p>DOCX_ABOUT_AUTHOR_END</p>" if page_breaks
  html.join("\n") + "\n"
end

def aftermatter_files(config)
  configured = config[:aftermatter_other] || config["aftermatter_other"] || config[:aftermatter] || config["aftermatter"] || config[:after_matter] || config["after_matter"]
  Array(configured).compact
end

def about_author_files(config)
  configured = config[:aftermatter_about_the_author] || config["aftermatter_about_the_author"] || config[:about_author] || config["about_author"]
  Array(configured).compact
end

def stay_connected_files(config)
  configured = config[:aftermatter_stay_connected] || config["aftermatter_stay_connected"]
  Array(configured).compact
end

PUBLISHER_NAME = "Morlock Publishing"
PUBLISHER_LOGO_FILENAME = "morlock_publishing_logo.png"

def publisher_name(config = nil)
  configured = config && (config[:publisher_name] || config["publisher_name"])
  configured.to_s.strip == "" ? PUBLISHER_NAME : configured.to_s
end

def publisher_logo_path(config = nil)
  configured = config && (config[:publisher_logo] || config["publisher_logo"])
  if configured.to_s.strip != ""
    path = File.expand_path(configured.to_s)
    raise "publisher logo not found: #{path}" unless File.file?(path)

    return path
  end

  [
    File.join(__dir__, "assets", PUBLISHER_LOGO_FILENAME),
    File.join("/home/tjic/writing/src/progress_tool/assets", PUBLISHER_LOGO_FILENAME)
  ].find { |path| File.exist?(path) }
end

def install_publisher_logo_asset
  source = publisher_logo_path
  return false unless source

  destination = File.join("assets", PUBLISHER_LOGO_FILENAME)
  return true if File.exist?(destination) && File.expand_path(source) == File.expand_path(destination)

  FileUtils.mkdir_p("assets")
  FileUtils.cp(source, destination)
  true
end

def frontmatter_toc_marker?(entry)
  return false if entry.is_a?(Hash)

  value = entry.is_a?(Symbol) ? entry.to_s : entry.to_s.strip
  value.sub(/\A:/, "").casecmp("toc").zero?
end

def frontmatter_entry_file(entry)
  return entry unless entry.is_a?(Hash)

  stringify_yaml_keys(entry)["file"]
end

def frontmatter_entry_style(entry)
  return nil unless entry.is_a?(Hash)

  stringify_yaml_keys(entry)["style"]
end

def frontmatter_timeline_entry?(entry)
  frontmatter_entry_style(entry).to_s.casecmp("timeline").zero?
end

def frontmatter_dramatis_entry?(entry)
  frontmatter_entry_style(entry).to_s.casecmp("dramatis").zero?
end

def half_title_verso_entry?(entry)
  file = frontmatter_entry_file(entry)
  file && File.basename(file.to_s).downcase.include?("other_books")
end

def half_title_verso_entry(config)
  other_books_files(config).first || frontmatter_files(config).find { |entry| !frontmatter_toc_marker?(entry) && half_title_verso_entry?(entry) }
end

def other_books_aftermatter_files(config)
  title_page_boolean(config, "show_half_title") ? [] : [half_title_verso_entry(config)].compact
end

def frontmatter_file_entries(config)
  other_books = other_books_files(config).map { |entry| frontmatter_entry_file(entry).to_s }
  frontmatter_files(config).reject do |entry|
    frontmatter_toc_marker?(entry) ||
      other_books.include?(frontmatter_entry_file(entry).to_s) ||
      half_title_verso_entry?(entry)
  end
end

def aftermatter_file_entries(config)
  named_files = about_author_files(config).concat(stay_connected_files(config)).map { |entry| frontmatter_entry_file(entry).to_s }
  aftermatter_files(config).reject { |entry| named_files.include?(frontmatter_entry_file(entry).to_s) }
end

def frontmatter_has_toc_marker?(config)
  frontmatter_files(config).any? { |entry| frontmatter_toc_marker?(entry) }
end

def frontmatter_toc_marker_count(config)
  frontmatter_files(config).count { |entry| frontmatter_toc_marker?(entry) }
end

def markdown_file?(file)
  [".md", ".markdown"].include?(File.extname(file).downcase)
end

def read_frontmatter_file(file)
  abort "*** ERROR: frontmatter file #{file} not found" unless File.exist?(file)

  File.read(file)
end

def matter_qr_code_files(config)
  configured = config && (config[:matter_qr_codes] || config["matter_qr_codes"])
  Array(configured).compact.map { |entry| File.expand_path(frontmatter_entry_file(entry).to_s) }
end

def matter_qr_codes_enabled_for?(config, file)
  matter_qr_code_files(config).include?(File.expand_path(file.to_s))
end

def matter_qr_code_data_uri(url)
  png = IO.popen(["qrencode", "--type=PNG", "--level=M", "--output=-", url], "rb", &:read)
  abort "*** ERROR: qrencode is required to generate QR codes" unless $?.success? && !png.empty?

  "data:image/png;base64,#{Base64.strict_encode64(png)}"
end

def matter_qr_code_html(url)
  %(<div custom-style="MatterQRCode"><p><img src="#{matter_qr_code_data_uri(url)}" alt="QR code for #{CGI.escapeHTML(url)}" style="width: 0.75in; height: 0.75in;" /></p></div>)
end

def add_matter_qr_codes(html)
  html.gsub(%r{<p>(https?://[^<\s]+)</p>}) do
    url = CGI.unescapeHTML($1)
    %(<p>#{$1}</p>\n#{matter_qr_code_html(url)})
  end
end

def matter_file_to_html(file, config)
  contents = read_frontmatter_file(file)
  html = markdown_file?(file) ? markdown_file_to_html(file) : plain_text_to_html(contents)
  matter_qr_codes_enabled_for?(config, file) ? add_matter_qr_codes(html) : html
end

def frontmatter_text(config)
  contents = frontmatter_file_entries(config).map { |entry| read_frontmatter_file(frontmatter_entry_file(entry)).strip }.reject(&:empty?)
  return "" if contents.empty?

  contents.join("\n\n") + "\n\n"
end

def aftermatter_text(config)
  files = aftermatter_file_entries(config) + stay_connected_files(config) + other_books_aftermatter_files(config) + about_author_files(config)
  contents = files.map { |entry| read_frontmatter_file(frontmatter_entry_file(entry)).strip }.reject(&:empty?)
  contents.unshift(reader_actions_text(config).strip)
  contents.reject!(&:empty?)
  return "" if contents.empty?

  contents.join("\n\n") + "\n\n"
end

def markdown_list_item?(line)
  line.match?(/^\s{0,3}([-+*]|\d+[.)])\s+\S/)
end

def normalize_markdown_frontmatter(contents)
  lines = contents.lines
  output = []
  idx = 0

  while idx < lines.size
    line = lines[idx]
    if line.strip == "" && output.any? && markdown_list_item?(output.last)
      next_idx = idx + 1
      next_idx += 1 while next_idx < lines.size && lines[next_idx].strip == ""
      if next_idx < lines.size && markdown_list_item?(lines[next_idx])
        idx += 1
        next
      end
    end

    output << line
    idx += 1
  end

  output.join
end

def markdown_file_to_html(file)
  IO.popen(["pandoc", "-f", "markdown+hard_line_breaks", "-t", "html"], "r+") do |io|
    io.write(normalize_markdown_frontmatter(read_frontmatter_file(file)))
    io.close_write
    html = io.read
    io.close
    abort "*** ERROR: Failed to convert frontmatter markdown #{file} to HTML using pandoc" unless $?.success?

    html
  end
end

def plain_text_to_html(text)
  paragraphs = text.split(/\n\s*\n/).map(&:strip).reject(&:empty?)
  paragraphs.map do |paragraph|
    escaped = CGI.escapeHTML(paragraph.gsub(/\n/, " ").strip)
    "<p>#{escaped}</p>"
  end.join("\n")
end

def frontmatter_html(config)
  html_parts = frontmatter_file_entries(config).map do |entry|
    file = frontmatter_entry_file(entry)
    matter_file_to_html(file, config)
  end.map(&:strip).reject(&:empty?)

  return "" if html_parts.empty?

  html_parts.join("\n") + "\n"
end

def aftermatter_html(config)
  html_parts = aftermatter_file_entries(config).map do |entry|
    file = frontmatter_entry_file(entry)
    matter_file_to_html(file, config)
  end.map(&:strip).reject(&:empty?)

  return "" if html_parts.empty?

  html_parts.join("\n") + "\n"
end

def about_author_html(config)
  html_parts = about_author_files(config).map do |entry|
    file = frontmatter_entry_file(entry)
    matter_file_to_html(file, config)
  end.map(&:strip).reject(&:empty?)

  return "" if html_parts.empty?

  html = html_parts.join("\n")
  html = %(<h1>About the Author</h1>\n#{html}) unless html.match?(/\A\s*<h[12]\b[^>]*>\s*About the Author\s*<\/h[12]>/i)
  html + "\n"
end

def stay_connected_html(config)
  html_parts = stay_connected_files(config).map do |entry|
    file = frontmatter_entry_file(entry)
    matter_file_to_html(file, config)
  end.map(&:strip).reject(&:empty?)

  return "" if html_parts.empty?

  html = html_parts.join("\n")
  html = %(<h1>Stay Connected</h1>\n#{html}) unless html.match?(/\A\s*<h[12]\b[^>]*>\s*Stay Connected\s*<\/h[12]>/i)
  html + "\n"
end

def aftermatter_html_with_page_break_markers(config)
  html_parts = []
  aftermatter_file_entries(config).each_with_index do |entry, idx|
    file = frontmatter_entry_file(entry)
    html_parts << %(<p>DOCX_AFTERMATTER_PAGE_BREAK_#{idx}</p>)
    html_parts << matter_file_to_html(file, config).strip
  end

  return "" if html_parts.empty?

  html_parts.join("\n") + "\n"
end

def about_author_html_with_page_break_marker(config)
  html = about_author_html(config).strip
  return "" if html.empty?

  [
    "<p>DOCX_ABOUT_AUTHOR_PAGE_BREAK</p>",
    "<p>DOCX_ABOUT_AUTHOR_START</p>",
    html,
    "<p>DOCX_ABOUT_AUTHOR_END</p>"
  ].join("\n") + "\n"
end

def stay_connected_html_with_page_break_marker(config)
  html = stay_connected_html(config).strip
  return "" if html.empty?

  [
    "<p>DOCX_STAY_CONNECTED_PAGE_BREAK</p>",
    "<p>DOCX_STAY_CONNECTED_START</p>",
    html,
    "<p>DOCX_STAY_CONNECTED_END</p>"
  ].join("\n") + "\n"
end

def frontmatter_html_with_page_break_markers(config)
  html_parts = []
  full_layout = full_frontmatter_layout?(config)
  frontmatter_files(config).each_with_index do |entry, idx|
    if frontmatter_toc_marker?(entry)
      html_parts << "<p>DOCX_TOC_INSERT</p>"
      html_parts << "<p>DOCX_TOC_PAGE_BREAK</p>"
      html_parts << "<p>DOCX_TOC_AFTER_PAGE_BREAK</p>" if full_layout
      next
    end

    next if half_title_verso_entry?(entry)

    file = frontmatter_entry_file(entry)
    html = matter_file_to_html(file, config)
    timeline = frontmatter_timeline_entry?(entry)
    dramatis = frontmatter_dramatis_entry?(entry)
    html_parts << "<p>DOCX_FRONTMATTER_TIMELINE_START</p>" if timeline
    html_parts << "<p>DOCX_FRONTMATTER_DRAMATIS_START</p>" if dramatis
    html_parts << html.strip
    html_parts << %(<p>DOCX_FRONTMATTER_PAGE_BREAK_#{idx}_VERSO</p>)
    if full_layout && timeline
      html_parts << %(<p>DOCX_FRONTMATTER_PAGE_BREAK_#{idx}_RECTO</p>)
      html_parts << "<p>DOCX_FRONTMATTER_TIMELINE_END</p>"
    elsif full_layout && dramatis
      html_parts << "<p>DOCX_FRONTMATTER_DRAMATIS_END</p>"
    else
      html_parts << "<p>DOCX_FRONTMATTER_TIMELINE_END</p>" if timeline
      html_parts << "<p>DOCX_FRONTMATTER_DRAMATIS_END</p>" if dramatis
      html_parts << %(<p>DOCX_FRONTMATTER_PAGE_BREAK_#{idx}_RECTO</p>) if full_layout
    end
  end.flatten.reject(&:empty?)

  return "" if html_parts.empty?

  html_parts.join("\n") + "\n"
end

def config_author(config)
  config[:author] || config["author"]
end

def title_page_value_lines(value)
  Array(value).flatten.compact.map(&:to_s).map(&:strip).reject(&:empty?)
end

def title_page_value_html(value)
  title_page_value_lines(value).map { |line| CGI.escapeHTML(line) }.join("<br />")
end

def docx_paragraph_contains_title_value?(paragraph_xml, value)
  title_page_value_lines(value).all? { |line| paragraph_xml.include?(docx_xml_text_for(line)) }
end

def half_title_page_html(config)
  title = config[:title] || config["title"] || $title
  html_parts = [%(<section class="half-title-page" style="text-align: center;">), %(<p>DOCX_HALF_TITLE_START</p>)]
  title_page = title_page_config(config)
  if split_title_page?(config)
    html_parts << %(<p>DOCX_HALF_TITLE_START</p>)
    html_parts << %(<h1>#{title_page_value_html(title_page["series_title"])}</h1>)
    conjunction = title_page["conjunction"]
    html_parts << %(<p>#{title_page_value_html(conjunction)}</p>) unless title_page_value_lines(conjunction).empty?
    html_parts << %(<h1>#{title_page_value_html(title_page["book_title"])}</h1>)
  else
    html_parts << %(<h1>#{CGI.escapeHTML(title.to_s)}</h1>)
  end
  html_parts << %(</section>)
  html_parts.join("\n") + "\n"
end

def other_books_link_html(config)
  settings = config[:other_books_link] || config["other_books_link"] || {}
  abort "*** ERROR: :other_books_link must contain url and format fields" unless settings.is_a?(Hash)
  settings = stringify_yaml_keys(settings)
  url = settings["url"].to_s.strip
  return "" if url.empty?

  begin
    uri = URI.parse(url)
    valid_url = uri.is_a?(URI::HTTP) && !uri.host.to_s.empty?
  rescue URI::InvalidURIError
    valid_url = false
  end
  abort "*** ERROR: :other_books_link.url must be an absolute HTTP(S) URL" unless valid_url
  format = settings.fetch("format", "link").to_s
  abort "*** ERROR: :other_books_link.format must be link or qr" unless %w[link qr].include?(format)

  label = CGI.escapeHTML(settings.fetch("label", "Find more books").to_s)
  if format == "qr"
    matter_qr_code_html(url) + %(<p style="text-align: center;">#{label}</p>)
  else
    %(<p style="text-align: center;"><a href="#{CGI.escapeHTML(url)}"><u>#{label}</u></a></p>)
  end
end

def edition_format(config)
  format = (config[:edition_format] || config["edition_format"] || "print").to_s
  abort "*** ERROR: :edition_format must be print or ebook" unless %w[print ebook].include?(format)

  format
end

def half_title_verso_html(config)
  entry = half_title_verso_entry(config)
  return "" unless entry

  file = frontmatter_entry_file(entry)
  html = matter_file_to_html(file, config)
  format = edition_format(config)
  # Style only bibliography links; keep title emphasis and other matter links.
  html = html.gsub(%r{<a\b([^>]*)>(.*?)</a>}mi) do
    attributes, title = $1, $2.gsub(%r{</?u\b[^>]*>}i, "")
    format == "ebook" ? "<a#{attributes}><u>#{title}</u></a>" : title
  end
  html = polish_half_title_verso_html(html)
  catalog_url = reader_action_settings(config)["catalog_url"]
  if catalog_url.empty?
    html += other_books_link_html(config)
  elsif format == "ebook"
    html = html.sub(%r{(<h1\b[^>]*>)(.*?)(</h1>)}m) do
      opening, title, closing = $1, $2, $3
      title = title.gsub(%r{</?a\b[^>]*>}i, "")
      %(#{opening}<a href="#{CGI.escapeHTML(catalog_url)}"><u>#{title}</u></a>#{closing})
    end
  else
    link = reader_action_item_html({ title: "Browse all my books on Amazon", url: catalog_url }, format)
    html += %(<div custom-style="OtherBooksCatalog">#{link}</div>)
  end
  %(<section class="half-title-verso">\n<p>DOCX_HALF_TITLE_VERSO_START</p>\n#{html.strip}\n<p>DOCX_HALF_TITLE_VERSO_END</p>\n</section>\n)
end

def polish_half_title_verso_html(html)
  html = html.gsub(%r{<ul>\s*(.*?)\s*</ul>}m) do
    $1.scan(%r{<li>(.*?)</li>}m).map { |match| "<p><em>#{match.first}</em></p>" }.join("\n")
  end
  html = html.gsub(%r{<p>\*\*\s+(.*?)</p>}m, '<p><em>\1</em></p>')
  html = html.gsub(%r{<p>((?!<em\b).*?)</p>}m, '<p><em>\1</em></p>')
  html.gsub(/<(h1|h2|p)\b([^>]*)>/) { "<#{$1}#{$2} style=\"text-align: center;\">" }
end

def title_page_html(config)
  title = config[:title] || config["title"] || $title
  author = config_author(config)
  html_parts = [
    %(<section class="title-page" style="text-align: center;">)
  ]
  html_parts << %(<p>DOCX_TITLE_PAGE_START</p>)
  title_page = title_page_config(config)
  if split_title_page?(config)
    html_parts << %(<h1>#{title_page_value_html(title_page["series_title"])}</h1>)
    conjunction = title_page["conjunction"]
    html_parts << %(<p>#{title_page_value_html(conjunction)}</p>) unless title_page_value_lines(conjunction).empty?
    html_parts << %(<h1>#{title_page_value_html(title_page["book_title"])}</h1>)
  else
    html_parts << %(<h1>#{CGI.escapeHTML(title.to_s)}</h1>)
  end
  unless author.nil? || author.to_s.strip == ""
    html_parts << %(<h2>#{CGI.escapeHTML(author.to_s)}</h2>)
  end
  html_parts << publisher_page_html(config)
  html_parts << %(</section>)
  html_parts.join("\n") + "\n"
end

def title_page_config(config)
  stringify_yaml_keys(config[:title_page] || config["title_page"] || {})
end

def title_page_boolean(config, key, default = true)
  value = title_page_config(config)[key.to_s]
  return default if value.nil?

  value == true || value.to_s.casecmp("true").zero?
end

def split_title_page?(config)
  title_page = title_page_config(config)
  title_page["layout"].to_s == "split_title" &&
    title_page["series_title"].to_s.strip != "" &&
    title_page["book_title"].to_s.strip != ""
end

def compact_title_page?(title)
  title.to_s.gsub(/\s+/, " ").strip.length > 55
end

def copyright_page_config(config)
  config[:copyright_page] || config["copyright_page"]
end

def copyright_page_enabled?(config)
  value = copyright_page_config(config)
  value == true || value.is_a?(Hash)
end

def copyright_page_value(config, key, default)
  value = copyright_page_config(config)
  return default unless value.is_a?(Hash)

  stringified = stringify_yaml_keys(value)
  stringified.fetch(key.to_s, default)
end

def copyright_page_rights_text(value)
  return "All rights reserved. No portion of this book may be used or reproduced in any manner whatsoever without written permission from the publisher and copyright holder." if value.to_s == "all_rights_reserved"

  value.to_s
end

def copyright_page_credits(config)
  value = copyright_page_value(config, :credits, nil)
  value = copyright_page_value(config, :acknowledgements, value)
  value = copyright_page_value(config, :acknowledgments, value)
  return [] unless value.is_a?(Hash)

  stringify_yaml_keys(value).map { |label, names| [label.to_s, Array(names).flatten.compact.map(&:to_s).reject(&:empty?)] }
end

def copyright_page_label(label)
  text = label.to_s.tr("_", " ").strip
  return "" if text.empty?

  text[0].upcase + text[1..-1].to_s
end

def copyright_page_credit_text(label, names)
  clean_label = copyright_page_label(label)
  joined = names.join(", ")
  return "#{clean_label}: #{joined}" if clean_label.match?(/assistance|tools|disclosure/i)
  return "#{clean_label} by #{joined}." if clean_label.match?(/design|maps|art|illustration|cover|interior|edge/i)

  "#{clean_label}: #{joined}"
end

def copyright_page_credits_html(config)
  copyright_page_credits(config).reject { |_label, names| names.empty? }.map do |label, names|
    %(<p>#{CGI.escapeHTML(copyright_page_credit_text(label, names))}</p>)
  end.join("\n")
end

def copyright_page_url_display(url)
  url.to_s.sub(%r{\Ahttps?://}, "").sub(%r{\Awww\.}, "")
end

def copyright_page_publisher_html(publisher, urls, location = nil)
  lines = [publisher.to_s] + urls.map { |url| copyright_page_url_display(url) }
  lines << location.to_s unless location.to_s.strip.empty?
  %(<p>#{lines.map { |line| CGI.escapeHTML(line) }.join("<br />")}</p>)
end

def copyright_page_isbn_entries(config)
  isbn = copyright_page_value(config, :isbn, nil)
  entries = []
  if isbn.is_a?(Hash)
    stringify_yaml_keys(isbn).each do |format, value|
      next if value.nil? || value.to_s.strip == ""

      entries << ["#{copyright_page_label(format)} ISBN", value.to_s]
    end
  elsif !isbn.nil? && isbn.to_s.strip != ""
    entries << ["ISBN", isbn.to_s]
  end

  {
    "Print ISBN" => copyright_page_value(config, :isbn_print, nil),
    "Paperback ISBN" => copyright_page_value(config, :isbn_paperback, nil),
    "E-book ISBN" => copyright_page_value(config, :isbn_ebook, nil),
    "Audiobook ISBN" => copyright_page_value(config, :isbn_audiobook, nil)
  }.each do |label, value|
    entries << [label, value.to_s] unless value.nil? || value.to_s.strip == ""
  end

  entries
end

def copyright_page_isbns_html(config)
  copyright_page_isbn_entries(config).map do |label, value|
    %(<p>#{CGI.escapeHTML(label)}: #{CGI.escapeHTML(value)}</p>)
  end.join("\n")
end

def copyright_page_revision_history_html(config)
  entries = copyright_page_value(config, :revision_history, []) || []
  abort "*** ERROR: copyright_page.revision_history must be a list" unless entries.is_a?(Array)

  return "" if entries.empty?

  lines = entries.map do |entry|
    abort "*** ERROR: each revision_history entry needs date and description" unless entry.is_a?(Hash)
    entry = stringify_yaml_keys(entry)
    date_text = entry["date"].to_s
    description = entry["description"].to_s.strip
    abort "*** ERROR: revision_history description must not be blank" if description.empty?
    begin
      raise ArgumentError unless date_text.match?(/\A\d{4}-\d{2}(?:-\d{2})?\z/)
      date = Date.iso8601(date_text.length == 7 ? "#{date_text}-01" : date_text)
    rescue ArgumentError
      abort "*** ERROR: revision_history date must be a valid YYYY-MM or YYYY-MM-DD"
    end
    label = date.strftime(date_text.length == 7 ? "%B %Y" : "%B %-d, %Y")
    [date, "#{CGI.escapeHTML(label)}: #{CGI.escapeHTML(description)}"]
  end.sort_by(&:first).map(&:last).join("<br />\n")
  %(<div custom-style="CopyrightRevisionHeading"><p>Revision history:</p></div>\n<div custom-style="CopyrightRevisionHistory" style="margin-left: 0.25in;"><p>#{lines}</p></div>)
end

def copyright_page_html(config)
  return "" unless copyright_page_enabled?(config)

  title = config[:title] || config["title"] || $title
  author = config_author(config)
  year = copyright_page_value(config, :year, Time.now.year)
  holder = copyright_page_value(config, :holder, PUBLISHER_NAME)
  publisher = copyright_page_value(config, :publisher, PUBLISHER_NAME)
  publisher_urls = Array(copyright_page_value(config, :publisher_urls, copyright_page_value(config, :publisher_url, nil))).flatten.compact.map(&:to_s).reject(&:empty?)
  publisher_location = copyright_page_value(config, :publisher_location, nil)
  rights = copyright_page_rights_text(copyright_page_value(config, :rights, "all_rights_reserved"))
  note = copyright_page_value(config, :note, nil)
  printed_in = copyright_page_value(config, :printed_in, nil)
  print_number_line = copyright_page_value(config, :print_number_line, nil)

  html_parts = [
    %(<section class="copyright-page">),
    %(<p>DOCX_COPYRIGHT_START</p>),
    %(<p>#{CGI.escapeHTML(title.to_s.upcase)}</p>),
    %(<p>Copyright © #{CGI.escapeHTML(year.to_s)} #{CGI.escapeHTML(holder.to_s)}</p>),
    %(<p>#{CGI.escapeHTML(rights.to_s)}</p>)
  ]
  html_parts << %(<p>#{CGI.escapeHTML(note.to_s)}</p>) unless note.nil? || note.to_s.strip == ""
  credits = copyright_page_credits_html(config)
  html_parts << credits unless credits.empty?
  isbns = copyright_page_isbns_html(config)
  html_parts << isbns unless isbns.empty?
  html_parts << %(<p>Printed in #{CGI.escapeHTML(printed_in.to_s)}</p>) unless printed_in.nil? || printed_in.to_s.strip == ""
  html_parts << %(<p>#{CGI.escapeHTML(print_number_line.to_s)}</p>) unless print_number_line.nil? || print_number_line.to_s.strip == ""
  html_parts << copyright_page_revision_history_html(config)
  html_parts << %(<p>DOCX_COPYRIGHT_PUBLISHER_START</p>)
  html_parts << copyright_page_publisher_html(publisher, publisher_urls, publisher_location)
  html_parts << %(<p>DOCX_COPYRIGHT_PUBLISHER_END</p>)
  html_parts << %(<p>DOCX_COPYRIGHT_END</p>)
  html_parts << %(</section>)
  html_parts.join("\n") + "\n"
end

def publisher_page_html(config)
  year = Time.now.year
  logo = publisher_logo_path(config)
  html_parts = [
    %(<div class="publisher-page" style="text-align: center;">)
  ]
  html_parts << %(<p style="text-align: center;">#{CGI.escapeHTML(publisher_name(config))}</p>) if title_page_boolean(config, "show_publisher")
  html_parts << %(<p style="text-align: center;">#{year}</p>) if title_page_boolean(config, "show_year")
  if logo
    html_parts << %(<p style="text-align: center;"><img src="#{CGI.escapeHTML(logo)}" style="width: 1.35in;" /></p>)
  end
  html_parts << %(</div>)
  html_parts.join("\n") + "\n"
end

def chapter_header_from_interleaved_item(item)
  lines = remove_arrows(item[:text]).split("\n")
  lines[0].sub(/^\*\*\s*/, "")
end

def scene_markers_as_headings?(config)
  value = config && (config[:scene_markers] || config["scene_markers"])
  value.to_s.casecmp("heading").zero?
end

def scene_marker_paragraph?(paragraph)
  paragraph.match?(/\A\*\*\*\s+\S/)
end

def dinkus_paragraph?(paragraph)
  ["***", "* * *"].include?(paragraph.to_s.strip)
end

def manuscript_subheading?(paragraph)
  paragraph.match?(/\A##\s+\S/)
end

def split_manuscript_paragraphs(text)
  paragraphs = []
  current = []
  text.lines.each do |line|
    stripped = line.strip
    if stripped.empty?
      paragraphs << current.join("\n") unless current.empty?
      current = []
    elsif dinkus_paragraph?(stripped) || scene_marker_paragraph?(stripped) || manuscript_subheading?(stripped)
      paragraphs << current.join("\n") unless current.empty?
      paragraphs << stripped
      current = []
    else
      current << line
    end
  end
  paragraphs << current.join("\n") unless current.empty?
  paragraphs
end

def extract_markdown_footnotes(text)
  definitions = {}
  output = []
  lines = text.to_s.lines
  index = 0

  while index < lines.length
    match = lines[index].chomp.match(/\A\[\^([^\]\n]+)\]:\s*(.*)\z/)
    unless match
      output << lines[index]
      index += 1
      next
    end

    body = [match[2].strip]
    index += 1
    while index < lines.length && lines[index].match?(/\A(?: {2,}|\t)/)
      body << lines[index].strip
      index += 1
    end
    definitions[match[1]] = body.join(" ")
  end

  [output.join, definitions]
end

def footnote_references_for_html(text, definitions, numbers)
  text.gsub(/\[\^([^\]\n]+)\]/) do
    label = Regexp.last_match(1)
    next Regexp.last_match(0) unless definitions.key?(label)

    number = numbers[label] ||= numbers.length + 1
    "<span id=\"endnote_reference_#{number}\"><sup>#{number}</sup></span>"
  end
end

def convert_scene_markers_to_dinkuses(text, config)
  text = text.gsub(/^\*\*\*\s*$/, "* * *")
  return text if scene_markers_as_headings?(config)

  text.gsub(/^\*\*\*\s+\S.*$/, "* * *")
end

# Format interleaved data as plain text
def format_interleaved_as_text(interleaved, config = nil)
  output_lines = []
  frontmatter = config ? frontmatter_text(config) : ""
  output_lines << frontmatter unless frontmatter.empty?

  interleaved.each do |item|
    if item[:type] == :act
      output_lines << remove_arrows(item[:line])
      output_lines << ""
    elsif item[:type] == :xxx
      output_lines << remove_arrows(item[:line])
      output_lines << ""
    elsif item[:type] == :chapter
      output_lines << convert_scene_markers_to_dinkuses(remove_arrows(item[:text]), config)
      output_lines << ""
    end
  end

  aftermatter = config ? aftermatter_text(config) : ""
  output_lines << aftermatter unless aftermatter.empty?

  output_lines.join("\n")
end

def append_text_with_line_source(lines, line_sources, text, source)
  text.to_s.split("\n", -1).each do |line|
    lines << line
    line_sources[lines.size] = source
  end
end

def format_interleaved_as_text_with_sources(interleaved, config = nil)
  output_lines = []
  line_sources = {}
  files = config ? frontmatter_file_entries(config) : []
  files.each_with_index do |file, idx|
    source = frontmatter_entry_file(file)
    append_text_with_line_source(output_lines, line_sources, "\n", source) if idx > 0
    append_text_with_line_source(output_lines, line_sources, read_frontmatter_file(source), source)
  end
  append_text_with_line_source(output_lines, line_sources, "\n", "frontmatter") unless files.empty?

  interleaved.each do |item|
    source = item[:source_file] || "interleaved"
    if item[:type] == :act
      append_text_with_line_source(output_lines, line_sources, remove_arrows(item[:line]), source)
      append_text_with_line_source(output_lines, line_sources, "", source)
    elsif item[:type] == :xxx
      append_text_with_line_source(output_lines, line_sources, remove_arrows(item[:line]), source)
      append_text_with_line_source(output_lines, line_sources, "", source)
    elsif item[:type] == :chapter
      append_text_with_line_source(output_lines, line_sources, convert_scene_markers_to_dinkuses(remove_arrows(item[:text]), config), source)
      append_text_with_line_source(output_lines, line_sources, "", source)
    end
  end

  if config
    actions_text = reader_actions_text(config)
    unless actions_text.empty?
      append_text_with_line_source(output_lines, line_sources, actions_text, ".rakefile.yaml")
    end
  end
  files = config ? aftermatter_file_entries(config) + stay_connected_files(config) + other_books_aftermatter_files(config) + about_author_files(config) : []
  append_text_with_line_source(output_lines, line_sources, "\n", "aftermatter") unless files.empty?
  files.each_with_index do |file, idx|
    source = frontmatter_entry_file(file)
    append_text_with_line_source(output_lines, line_sources, "\n", source) if idx > 0
    append_text_with_line_source(output_lines, line_sources, read_frontmatter_file(source), source)
  end

  { :text => output_lines.join("\n"), :line_sources => line_sources }
end

# Opening typography is independent of whether this edition includes a TOC.
def opening_title?(interleaved, config)
  config ||= {}
  value = config.fetch(:opening_title) { config.fetch("opening_title", "auto") }
  case value
  when true, false
    value
  when "auto"
    chapters = interleaved.select { |item| item[:type] == :chapter }
    chapters.any? && chapters.all? { |item| item[:chapterless] }
  else
    abort "*** ERROR: :opening_title must be auto, true, or false"
  end
end

# Format interleaved data as HTML
def format_interleaved_as_html(interleaved, config = nil, include_title_page = false, frontmatter_page_breaks = false, include_toc = false)
  require 'cgi'

  html_parts = []
  footnote_definitions = interleaved.select { |item| item[:type] == :chapter }.each_with_object({}) do |item, definitions|
    _text, found = extract_markdown_footnotes(remove_arrows(item[:text]))
    definitions.merge!(found)
  end
  footnote_numbers = {}
  if config && include_title_page
    if title_page_boolean(config, "show_half_title")
      html_parts << half_title_page_html(config)
      html_parts << "<p>DOCX_HALF_TITLE_PAGE_BREAK</p>"
      html_parts << half_title_verso_html(config)
      html_parts << "<p>DOCX_HALF_TITLE_VERSO_PAGE_BREAK</p>"
    end
    html_parts << title_page_html(config)
    html_parts << "<p>DOCX_TITLE_PAGE_BREAK</p>"
    unless copyright_page_html(config).empty?
      html_parts << copyright_page_html(config)
      html_parts << "<p>DOCX_COPYRIGHT_PAGE_BREAK</p>"
    end
    dedication = dedication_html(config)
    unless dedication.empty?
      html_parts << dedication
      html_parts << "<p>DOCX_DEDICATION_PAGE_BREAK</p>"
      html_parts << "<p>DOCX_DEDICATION_END</p>"
      html_parts << "<p>DOCX_DEDICATION_PAGE_BREAK</p>" if full_frontmatter_layout?(config)
    end
  end

  if config && include_toc && frontmatter_toc_marker_count(config) > 1
    abort "*** ERROR: :TOC may appear only once in :frontmatter"
  end

  toc_in_frontmatter = config && include_toc && frontmatter_has_toc_marker?(config)
  if include_toc && !toc_in_frontmatter && !(config && (config[:toc] == false || config["toc"] == false))
    puts ":TOC not specified in :frontmatter; adding in default location" if config
    html_parts << "<p>DOCX_TOC_INSERT</p>"
    html_parts << "<p>DOCX_TOC_PAGE_BREAK</p>"
    html_parts << "<p>DOCX_TOC_AFTER_PAGE_BREAK</p>" if full_frontmatter_layout?(config)
  end
  html_parts << (frontmatter_page_breaks ? frontmatter_html_with_page_break_markers(config) : frontmatter_html(config)) if config
  html_parts << "<p>DOCX_MANUSCRIPT_START</p>" if include_toc

  if opening_title?(interleaved, config)
    title = config && (config[:title] || config["title"])
    html_parts << %(<h2 id="story-title" style="text-align: center;">#{CGI.escapeHTML((title || $title).to_s)}</h2>)
  end

  chapter_idx = 0
  interleaved.each do |item|
    if item[:type] == :act
      # Remove leading asterisks from act line: "* Act 1: ..." -> "<h1>Act 1: ...</h1>"
      act_text = item[:line].sub(/^\*\s*/, "")
      act_text = remove_arrows(act_text)
      # Process italics in act text
      act_text = process_inline_markup_for_html(act_text, config)
      html_parts << "<h1>#{act_text}</h1>"
      html_parts << "<p>DOCX_ACT_PAGE_BREAK</p>" if include_toc
    elsif item[:type] == :xxx
      xxx_text = remove_arrows(item[:line])
      html_parts << "<p>#{CGI.escapeHTML(xxx_text)}</p>"
    elsif item[:type] == :chapter
      # Parse chapter header and content
      lines = remove_arrows(item[:text]).split("\n")
      chapter_idx += 1
      unless item[:chapterless]
        chapter_header = process_inline_markup_for_html(lines.shift.to_s.sub(/^\*\*\s*/, ""), config)
        html_parts << %(<h2 id="chapter-#{chapter_idx}">#{chapter_header}</h2>)
      end
      content_lines = lines
      content_lines.shift while content_lines.first.to_s.strip.empty?
      epigraph_lines = []
      while content_lines.first.to_s.match?(/\A>\s?/) do
        epigraph_lines << content_lines.shift.sub(/\A>\s?/, "")
      end
      unless epigraph_lines.empty?
        attribution = epigraph_lines.pop if epigraph_lines.last.to_s.strip.start_with?("—")
        epigraph = epigraph_lines.map { |line| process_inline_markup_for_html(line, config) }.join("<br/>")
        html_parts << %(<div custom-style="ChapterEpigraph"><p>#{epigraph}</p></div>) unless epigraph.empty?
        html_parts << %(<div custom-style="ChapterEpigraphAttribution"><p>#{process_inline_markup_for_html(attribution, config)}</p></div>) if attribution
      end
      content_text, _definitions = extract_markdown_footnotes(content_lines.join("\n"))
      content_text = content_text.strip
      if content_text.length > 0
        # Split by double newlines to identify paragraphs
        paragraphs = split_manuscript_paragraphs(content_text)
        paragraphs.each do |para|
          if dinkus_paragraph?(para) || (scene_marker_paragraph?(para) && !scene_markers_as_headings?(config))
            html_parts << %(<div custom-style="Dinkus"><p>* * *</p></div>)
          elsif para.match?(/\A\*\*\*\s+\S/)
            heading_text = para.sub(/\A\*\*\*\s+/, "")
            html_parts << "<h3>#{process_inline_markup_for_html(heading_text, config)}</h3>"
          elsif manuscript_subheading?(para)
            heading_text = para.sub(/\A##\s+/, "")
            html_parts << "<h3>#{process_inline_markup_for_html(heading_text, config)}</h3>"
          else
            # Process italics in each paragraph and replace single newlines with spaces
            para_text = para.lines.map { |line| process_line_markup_for_html(line.chomp, config) }.join(" ").strip
            para_text = process_bold_for_html(para_text)
            # Keep a trailing interruption dash attached to the preceding word.
            para_text = para_text.sub(/ (?=-(?:["”])?\z)/, "\u00a0")
            para_text = footnote_references_for_html(para_text, footnote_definitions, footnote_numbers)
            html_parts << "<p>#{para_text}</p>"
          end
        end
      end
      html_parts << "<p>DOCX_CHAPTER_PAGE_BREAK</p>" if include_toc
    end
  end

  final_chapter_break = html_parts.pop if footnote_numbers.any? && html_parts.last == "<p>DOCX_CHAPTER_PAGE_BREAK</p>"
  footnote_numbers.sort_by { |_label, number| number }.each do |label, number|
    html_parts << "<p>#{number}. (page DOCX_ENDNOTE_PAGE_#{number}) #{process_inline_markup_for_html(footnote_definitions.fetch(label), config)}</p>"
  end
  html_parts << final_chapter_break if final_chapter_break
  html_parts << "<p>DOCX_MANUSCRIPT_END</p>" if include_toc
  if config
    html_parts << reader_actions_html(config, frontmatter_page_breaks)
    html_parts << (frontmatter_page_breaks ? aftermatter_html_with_page_break_markers(config) : aftermatter_html(config))
    html_parts << (frontmatter_page_breaks ? stay_connected_html_with_page_break_marker(config) : stay_connected_html(config))
    unless other_books_aftermatter_files(config).empty?
      html_parts << "<p>DOCX_AFTERMATTER_PAGE_BREAK_other_books</p>" if frontmatter_page_breaks
      html_parts << half_title_verso_html(config)
    end
    html_parts << (frontmatter_page_breaks ? about_author_html_with_page_break_marker(config) : about_author_html(config))
  end

  html_parts.join("\n")
end

def build_interleaved_chapters_for_targets(config)
  all_data = {}
  all_acts = {}
  max_chapter = 0
  leading_xxx_lines = []

  $target_files.each do |file|
    data = parse_chapters_and_acts_from_file(file, config)
    all_data[file] = data
    all_acts[file] = data[:acts]
    leading_xxx_lines.concat(data[:leading_xxx_lines] || [])
    max_chapter = [max_chapter, data[:chapters].keys.max || 0].max
  end

  if max_chapter == 0
    abort "No chapters found in any source files"
  end

  # Build pragma registry and validate
  pragma_registry = build_pragma_registry(all_data, $target_files)

  # Report validation errors
  if pragma_registry[:undefined_tags].size > 0
    puts "*** WARNING: Undefined pragma tags: #{pragma_registry[:undefined_tags].join(', ')}"
  end

  if pragma_registry[:unused_tags].size > 0
    puts "*** WARNING: Unused pragma tags: #{pragma_registry[:unused_tags].join(', ')}"
  end

  if pragma_registry[:circular_deps].size > 0
    abort "*** ERROR: Circular dependencies detected in pragmas: #{pragma_registry[:circular_deps].join(', ')}"
  end

  interleaved = build_interleaved_data(all_data, all_acts, max_chapter, pragma_registry)
  unless leading_xxx_lines.empty?
    interleaved = leading_xxx_lines.map do |entry|
      { :type => :xxx, :line => label_leading_xxx_line(entry[:line], entry[:source_id]), :source_file => entry[:source_file] }
    end + interleaved
  end

  {
    :all_data => all_data,
    :all_acts => all_acts,
    :max_chapter => max_chapter,
    :pragma_registry => pragma_registry,
    :interleaved => interleaved
  }
end

def print_interleave_summary(max_chapter)
  puts "  Max chapter number: #{max_chapter}"
  puts "  Source files: #{$target_files.join(', ')}"
end

def print_pragma_output_validation(interleaved, pragma_registry, all_data)
  if pragma_registry[:chapter_dependencies].size > 0 || pragma_registry[:chapter_must_come_before].size > 0 || pragma_registry[:tag_definitions].size > 0
    puts ""
    puts "Pragma constraint verification:"
    validate_pragma_constraints_in_output(interleaved, pragma_registry, all_data, $target_files)
  end
end

def draft_output_basename(config)
  title = config[:title] || config["title"] || $title || "output"
  draft = config[:draft] || config["draft"] || 0
  title_part = title.to_s.strip.gsub(/\s+/, "_").gsub(/[\/\\]/, "_").delete(":")
  title_part = "output" if title_part == ""

  "#{title_part}_draft_#{draft}"
end

def draft_output_file(config, extension)
  "#{draft_output_basename(config)}.#{extension.to_s.sub(/\A\./, "")}"
end

desc "Interleave chapters from all source files and write to <title>_draft_<N>.txt"
task :interleave_txt do
  result = build_interleaved_chapters_for_targets(config)
  all_data = result[:all_data]
  max_chapter = result[:max_chapter]
  pragma_registry = result[:pragma_registry]
  interleaved = result[:interleaved]

  # --- BOOK SPLIT FEATURE ---
  if book_split
    # Normalize book_split keys and values
    book_split = book_split.transform_keys(&:to_s)
    book_to_acts = {}
    book_split.each do |book, acts|
      book_to_acts[book] = acts.map(&:to_s)
    end

    # Gather all act names in the interleaved output (in order of appearance)
    all_act_names = interleaved.select { |item| item[:type] == :act }.map do |item|
      # Extract act name (e.g., '1', '2A', '2B', '3') from line
      line = item[:line]
      line[/^\*\s*Act\s*([\w\-]+)/i, 1] || line.gsub(/^\*\s*Act\s*/i, '').strip
    end

    # Validation: every act must be assigned to exactly one book
    act_to_books = Hash.new { |h, k| h[k] = [] }
    book_to_acts.each do |book, acts|
      acts.each { |act| act_to_books[act] << book }
    end

    # Error if any act is not assigned to a book
    missing_acts = all_act_names.uniq - act_to_books.keys
    unless missing_acts.empty?
      abort "*** ERROR: The following acts are not assigned to any book in book_split: #{missing_acts.join(', ')}"
    end

    # Error if any act is assigned to multiple books
    multi_books = act_to_books.select { |act, books| books.size > 1 }
    unless multi_books.empty?
      msg = multi_books.map { |act, books| "Act '#{act}' assigned to multiple books: #{books.join(', ')}" }.join("\n  ")
      abort "*** ERROR: The following acts are assigned to multiple books in book_split:\n  #{msg}"
    end

    # Output only a specific book if BOOK env var is set
    selected_books = if ENV['BOOK']
      [ENV['BOOK'].to_s]
    else
      book_to_acts.keys
    end

    selected_books.each do |book|
      acts_for_book = book_to_acts[book]
      # Output acts in the order listed in book_split
      filtered = []
      current_act = nil
      acts_seen = []
      interleaved.each do |item|
        if item[:type] == :act
          act_name = item[:line][/^\*\s*Act\s*([\w\-]+)/i, 1] || item[:line].gsub(/^\*\s*Act\s*/i, '').strip
          current_act = act_name
          next unless acts_for_book.include?(act_name)
          # Only output act if it's in this book
          filtered << item
          acts_seen << act_name unless acts_seen.include?(act_name)
        elsif item[:type] == :xxx
          filtered << item
        elsif item[:type] == :chapter
          # Only output chapters that belong to the current act for this book
          if current_act && acts_for_book.include?(current_act)
            filtered << item
          end
        end
      end
      # Error if acts appear out of order
      if acts_seen != acts_for_book
        abort "*** ERROR: Acts for book '#{book}' do not appear in the order specified in book_split.\n  Expected: #{acts_for_book.join(', ')}\n  Found:    #{acts_seen.join(', ')}"
      end
      output_text = format_interleaved_as_text(filtered, config)
      fname = book.gsub(/[^a-zA-Z0-9_\-]+/, '_') + ".txt"
      File.open(fname, "w") { |f| f.write(output_text) }
      puts "Wrote interleaved chapters to #{fname}"
    end
    print_interleave_summary(max_chapter)
    exit 0
  end
  # --- END BOOK SPLIT FEATURE ---

  output_text = format_interleaved_as_text(interleaved, config)
  output_file = draft_output_file(config, "txt")

  File.open(output_file, "w") do |f|
    f.write(output_text)
  end

  puts "Wrote interleaved chapters to #{output_file}"
  print_interleave_summary(max_chapter)

  # Validate pragma constraints in the output
  print_pragma_output_validation(interleaved, pragma_registry, all_data)
end

desc "Interleave chapters in memory, then show chapter overview for the result"
def print_interleaved_chapter_overview(config, hide_done)
  result = build_interleaved_chapters_for_targets(config)
  all_data = result[:all_data]
  max_chapter = result[:max_chapter]
  pragma_registry = result[:pragma_registry]
  interleaved = result[:interleaved]
  output_info = format_interleaved_as_text_with_sources(interleaved, nil)
  output_name = "interleaved"

  puts "Built interleaved chapters in memory"
  print_interleave_summary(max_chapter)
  print_pragma_output_validation(interleaved, pragma_registry, all_data)

  ret = get_chapter_hash(config, nil, [output_name], { output_name => output_info })
  print_chapter_report("#{$title} (interleaved)", config, ret, [output_name], { output_name => output_info }, :always, hide_done)
end

task :ich do
  print_interleaved_chapter_overview(config, false)
end

desc "Interleave chapters in memory, then show only incomplete chapters in the overview"
task :ichv do
  print_interleaved_chapter_overview(config, true)
end

def docx_reference_file(config)
  config[:docx_reference] || config["docx_reference"] || ".default.docx"
end

def default_docx_reference?(reference_file)
  File.basename(reference_file.to_s) == ".default.docx"
end

def docx_reference_has_style?(reference_file, style_id, style_type = "paragraph")
  require 'zip'

  Zip::File.open(reference_file) do |zip|
    entry = zip.find_entry("word/styles.xml")
    return false unless entry

    xml = entry.get_input_stream.read
    xml.include?(%(<w:style w:type="#{style_type}" w:)) &&
      xml.include?(%(w:styleId="#{style_id}"))
  end
rescue
  false
end

def docx_reference_style_has?(reference_file, style_id, pattern)
  require 'zip'

  Zip::File.open(reference_file) do |zip|
    entry = zip.find_entry("word/styles.xml")
    return false unless entry

    styles_xml = entry.get_input_stream.read
    styles_xml.match?(/<w:style\b(?=[^>]*w:styleId="#{Regexp.escape(style_id)}").*?#{pattern}.*?<\/w:style>/m)
  end
rescue
  false
end

def docx_reference_has_character_styles?(reference_file, styles)
  (styles["character_styles"] || {}).keys.all? do |style_id|
    docx_reference_has_style?(reference_file, style_id, "character")
  end
end

def refresh_default_docx_reference_if_needed(config)
  reference_file = docx_reference_file(config)
  return unless default_docx_reference?(reference_file)

  styles_file = docx_styles_file(config)
  styles = load_docx_styles(styles_file)
  create_default_docx_styles_yaml(styles_file)
  return if File.exist?(reference_file) &&
            File.mtime(reference_file) >= File.mtime(styles_file) &&
            docx_reference_has_style?(reference_file, "BodyText") &&
            docx_reference_has_style?(reference_file, "FirstParagraph") &&
            docx_reference_has_style?(reference_file, "Compact") &&
            docx_reference_has_style?(reference_file, "Dinkus") &&
            docx_reference_has_style?(reference_file, "MatterQRCode") &&
            docx_reference_has_style?(reference_file, "FrontmatterTimeline") &&
            docx_reference_has_style?(reference_file, "FrontmatterDramatisHeading") &&
            docx_reference_has_style?(reference_file, "FrontmatterDramatis") &&
            docx_reference_has_style?(reference_file, "OtherBooksHeading1") &&
            docx_reference_has_style?(reference_file, "OtherBooksHeading2") &&
            docx_reference_has_style?(reference_file, "OtherBooksTitle") &&
            docx_reference_has_style?(reference_file, "ChapterEpigraph") &&
            docx_reference_has_style?(reference_file, "ChapterEpigraphAttribution") &&
            docx_reference_has_style?(reference_file, "AboutAuthorHeading") &&
            docx_reference_has_style?(reference_file, "ReaderActionHeading") &&
            docx_reference_has_style?(reference_file, "AboutAuthorBody") &&
            docx_reference_has_style?(reference_file, "CopyrightTitle") &&
            docx_reference_has_style?(reference_file, "CopyrightBody") &&
            docx_reference_has_style?(reference_file, "CopyrightPublisher") &&
            docx_reference_style_has?(reference_file, "TitlePageTitle", %r{<w:suppressAutoHyphens\s*/>}) &&
            docx_reference_has_character_styles?(reference_file, styles)

  create_default_reference_docx(reference_file, true, styles_file)
end

def docx_include_review_notes?(config)
  value = config[:docx_include_review_notes] || config["docx_include_review_notes"]
  value == true || value.to_s.casecmp("true").zero?
end

def without_review_notes(interleaved)
  interleaved.reject { |item| item[:type] == :xxx }
end

def pandoc_docx_reference_args(config)
  reference_file = docx_reference_file(config)
  return [] if reference_file.nil? || reference_file.to_s.strip == ""

  unless File.exist?(reference_file)
    warn "*** WARNING: DOCX reference file #{reference_file} not found; generating #{File.basename(reference_file)} without a reference document"
    return []
  end

  ["--reference-doc=#{reference_file}"]
end

# Helper function to convert HTML to DOCX using Pandoc
# Pandoc properly preserves heading hierarchy
def convert_html_to_docx_pandoc(html_file, docx_file, config = {}, include_toc = false)
  args = ["pandoc", "-f", "html", html_file]
  args += pandoc_docx_reference_args(config) + ["-o", docx_file]
  result = system(*args)
  
  unless result && File.exist?(docx_file)
    abort "*** ERROR: Failed to convert #{html_file} to DOCX using pandoc"
  end
end

def docx_xml_text_for(text)
  CGI.escapeHTML(text.to_s)
end

def center_docx_paragraph(paragraph_xml)
  if paragraph_xml.include?("<w:pPr>")
    return paragraph_xml if paragraph_xml.include?("<w:jc ")

    paragraph_xml.sub("</w:pPr>", %(<w:jc w:val="center"/></w:pPr>))
  else
    paragraph_xml.sub("<w:p>", %(<w:p><w:pPr><w:jc w:val="center"/></w:pPr>))
  end
end

def reset_docx_paragraph_indent(paragraph_xml)
  if paragraph_xml.include?("<w:ind ")
    paragraph_xml.sub(/<w:ind\b[^>]*\/>/, %(<w:ind w:left="0" w:firstLine="0"/>))
  elsif paragraph_xml.include?("<w:pPr>")
    paragraph_xml.sub("</w:pPr>", %(<w:ind w:left="0" w:firstLine="0"/></w:pPr>))
  else
    paragraph_xml.sub("<w:p>", %(<w:p><w:pPr><w:ind w:left="0" w:firstLine="0"/></w:pPr>))
  end
end

def remove_docx_paragraph_numbering(paragraph_xml)
  paragraph_xml.gsub(/<w:numPr>.*?<\/w:numPr>/m, "")
end

def italicize_docx_paragraph_runs(paragraph_xml)
  paragraph_xml.gsub(/<w:r\b.*?<\/w:r>/m) do |run|
    next run if run.include?("<w:i")

    if run.include?("<w:rPr>")
      run.sub("</w:rPr>", "<w:i/></w:rPr>")
    else
      run.sub("<w:r>", "<w:r><w:rPr><w:i/></w:rPr>")
    end
  end
end

def suppress_docx_paragraph_auto_hyphenation(paragraph_xml)
  return paragraph_xml if paragraph_xml.include?("<w:suppressAutoHyphens")

  if paragraph_xml.include?("<w:pPr>")
    paragraph_xml.sub("</w:pPr>", "<w:suppressAutoHyphens/></w:pPr>")
  else
    paragraph_xml.sub("<w:p>", "<w:p><w:pPr><w:suppressAutoHyphens/></w:pPr>")
  end
end

def set_docx_paragraph_spacing(paragraph_xml, before_inches:, after_inches:)
  spacing = %(<w:spacing w:before="#{docx_inches_to_twips(before_inches)}" w:after="#{docx_inches_to_twips(after_inches)}"/>)
  paragraph_xml = paragraph_xml.sub(/<w:spacing\b[^>]*\/>/, spacing)
  return paragraph_xml if paragraph_xml.include?(spacing)

  if paragraph_xml.include?("</w:pPr>")
    paragraph_xml.sub("</w:pPr>", "#{spacing}</w:pPr>")
  else
    paragraph_xml.sub("<w:p>", "<w:p><w:pPr>#{spacing}</w:pPr>")
  end
end

def remove_docx_marker_runs(paragraph_xml, marker)
  paragraph_xml.gsub(/<w:r\b(?:(?!<\/w:r>).)*#{Regexp.escape(marker)}.*?<\/w:r>/m, "")
end

def docx_run_with_text(text, run_properties = "")
  return "" if text.empty?

  %(<w:r>#{run_properties}<w:t xml:space="preserve">#{text}</w:t></w:r>)
end

def docx_endnote_page_field(number)
  bookmark = "endnote_reference_#{number}"
  %(<w:r><w:fldChar w:fldCharType="begin"/></w:r>) +
    %(<w:r><w:instrText xml:space="preserve"> PAGEREF #{bookmark} </w:instrText></w:r>) +
    %(<w:r><w:fldChar w:fldCharType="separate"/></w:r>) +
    %(<w:r><w:t>?</w:t></w:r>) +
    %(<w:r><w:fldChar w:fldCharType="end"/></w:r>)
end

def replace_docx_endnote_page_markers(xml)
  xml.gsub(/<w:r\b.*?<\/w:r>/m) do |run|
    match = run.match(/<w:t\b[^>]*>(.*?)<\/w:t>/m)
    next run unless match

    marker = match[1].match(/DOCX_ENDNOTE_PAGE_(\d+)/)
    next run unless marker

    number = marker[1]
    before, _marker, after = match[1].partition(marker[0])
    run_properties = run[/<w:rPr\b.*?<\/w:rPr>/m].to_s
    docx_run_with_text(before, run_properties) + docx_endnote_page_field(number) + docx_run_with_text(after, run_properties)
  end
end

def remove_docx_paragraph_section_properties(paragraph_xml)
  paragraph_xml.gsub(/<w:sectPr\b.*?<\/w:sectPr>/m, "")
end

def set_docx_paragraph_style(paragraph_xml, style_id)
  if paragraph_xml.include?("<w:pStyle ")
    paragraph_xml.sub(/<w:pStyle\s+w:val="[^"]*"\s*\/>/, %(<w:pStyle w:val="#{style_id}"/>))
  elsif paragraph_xml.include?("<w:pPr>")
    paragraph_xml.sub("<w:pPr>", %(<w:pPr><w:pStyle w:val="#{style_id}"/>))
  else
    paragraph_xml.sub("<w:p>", %(<w:p><w:pPr><w:pStyle w:val="#{style_id}"/></w:pPr>))
  end
end

def add_docx_page_break_after_paragraph(paragraph_xml)
  return paragraph_xml if paragraph_xml.include?(%(<w:br w:type="page"))

  paragraph_xml.sub("</w:p>", %(<w:r><w:br w:type="page"/></w:r></w:p>))
end

def docx_page_break_paragraph
  %(<w:p><w:r><w:br w:type="page"/></w:r></w:p>)
end

def docx_section_break_paragraph(section_xml)
  %(<w:p><w:pPr>#{section_xml}</w:pPr></w:p>)
end

def docx_section_without_header_xml(styles, break_type:, number_format: nil, start: nil, header: false)
  section = docx_section_xml(styles)
  unless header
    section = section.gsub(/<w:headerReference\b[^>]*\/>/, "")
    section = section.gsub(/<w:footerReference\b[^>]*\/>/, "")
  end
  section = section.sub("<w:sectPr>", %(<w:sectPr><w:type w:val="#{break_type}"/>)) if break_type
  if number_format || start
    attrs = []
    attrs << %(w:fmt="#{number_format}") if number_format
    attrs << %(w:start="#{start}") if start
    section = section.sub("</w:sectPr>", %(<w:pgNumType #{attrs.join(" ")}/></w:sectPr>))
  end
  section
end

def docx_title_section_break_paragraph(config)
  styles = load_docx_styles(docx_styles_file(config))
  section = docx_section_without_header_xml(styles, break_type: "nextPage", header: false)
  docx_section_break_paragraph(section)
end

def docx_frontmatter_section_break_paragraph(config)
  styles = load_docx_styles(docx_styles_file(config))
  section = docx_section_without_header_xml(styles, break_type: "nextPage", number_format: "lowerRoman", start: 4, header: true)
  section = section.gsub(/<w:footerReference\s+w:type="even"\s+r:id="[^"]*"\s*\/>/, "")
  docx_section_break_paragraph(section)
end

def docx_body_section_xml(config)
  styles = load_docx_styles(docx_styles_file(config))
  break_type = styles.fetch("page", {}).fetch("body_start_on_recto", true) ? "oddPage" : "nextPage"
  docx_section_without_header_xml(styles, break_type: break_type, number_format: "decimal", start: 1, header: true)
end

DOCX_MANUSCRIPT_BOOKMARK = "RakefileManuscriptBody"

def next_docx_bookmark_id(xml)
  ids = xml.scan(/<w:bookmarkStart\b[^>]*\bw:id="(\d+)"/).flatten.map(&:to_i)
  (ids.max || 0) + 1
end

def replace_docx_manuscript_boundary_markers(xml, config = {})
  bookmark_id = next_docx_bookmark_id(xml)
  start_replaced = false
  end_replaced = false

  xml = xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
    if !start_replaced && paragraph.include?("DOCX_MANUSCRIPT_START")
      start_replaced = true
      docx_frontmatter_section_break_paragraph(config) +
        %(<w:p><w:bookmarkStart w:id="#{bookmark_id}" w:name="#{DOCX_MANUSCRIPT_BOOKMARK}"/></w:p>)
    elsif !end_replaced && paragraph.include?("DOCX_MANUSCRIPT_END")
      end_replaced = true
      %(<w:p><w:bookmarkEnd w:id="#{bookmark_id}"/></w:p>)
    else
      paragraph
    end
  end

  xml
end

def replace_final_docx_section(xml, section_xml)
  matches = xml.to_enum(:scan, /<w:sectPr\b.*?<\/w:sectPr>/m).map { Regexp.last_match }
  return xml if matches.empty?

  last = matches.last
  xml[0...last.begin(0)] + section_xml + xml[last.end(0)..-1]
end

def style_docx_headings_before_manuscript(xml)
  before_manuscript = true

  xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
    if paragraph.include?("DOCX_MANUSCRIPT_START")
      before_manuscript = false
      paragraph
    elsif before_manuscript
      paragraph
        .gsub(/<w:pStyle\s+w:val="Heading1"\s*\/>/, '<w:pStyle w:val="FrontmatterHeading1"/>')
        .gsub(/<w:pStyle\s+w:val="Heading2"\s*\/>/, '<w:pStyle w:val="FrontmatterHeading2"/>')
    else
      paragraph
    end
  end
end

def style_docx_timeline_frontmatter_regions(xml)
  before_manuscript = true
  timeline = false

  xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
    if paragraph.include?("DOCX_MANUSCRIPT_START")
      before_manuscript = false
      paragraph
    elsif before_manuscript && paragraph.include?("DOCX_FRONTMATTER_TIMELINE_START")
      timeline = true
      ""
    elsif before_manuscript && paragraph.include?("DOCX_FRONTMATTER_TIMELINE_END")
      timeline = false
      ""
    elsif before_manuscript && timeline &&
          !paragraph.include?("FrontmatterHeading1") &&
          !paragraph.include?("FrontmatterHeading2")
      paragraph = set_docx_paragraph_style(paragraph, "FrontmatterTimeline")
      paragraph = paragraph.sub(/(<w:t\b[^>]*>\d{4}:)\s+/, '\\1</w:t><w:tab/><w:t>')
      paragraph.sub(/(<w:t\b[^>]*>\d{4}:<\/w:t>)(?=<\/w:r>\s*<w:r>)/, '\\1<w:tab/>')
    else
      paragraph
    end
  end
end

def clear_docx_paragraph_layout_overrides(paragraph_xml)
  paragraph_xml.gsub(/<w:(?:ind|spacing)\b[^>]*\/>/, "")
end

def style_docx_dramatis_frontmatter_regions(xml, config)
  before_manuscript = true
  dramatis = false

  xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
    if paragraph.include?("DOCX_MANUSCRIPT_START")
      before_manuscript = false
      paragraph
    elsif before_manuscript && paragraph.include?("DOCX_FRONTMATTER_DRAMATIS_START")
      dramatis = true
      ""
    elsif before_manuscript && paragraph.include?("DOCX_FRONTMATTER_DRAMATIS_END")
      dramatis = false
      full_frontmatter_layout?(config) ? docx_page_break_paragraph : ""
    elsif before_manuscript && dramatis
      style = paragraph.include?("FrontmatterHeading1") || paragraph.include?("FrontmatterHeading2") ?
        "FrontmatterDramatisHeading" : "FrontmatterDramatis"
      paragraph = clear_docx_paragraph_layout_overrides(set_docx_paragraph_style(paragraph, style))
      style == "FrontmatterDramatis" ?
        paragraph.sub(/(<w:t\b[^>]*>)\s*(\xE2\x80\x94)\s*/n, '\\1\\2</w:t><w:tab/><w:t>'.b) : paragraph
    else
      paragraph
    end
  end
end

def style_docx_matter_qr_codes(xml)
  xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
    if paragraph.include?("<w:drawing") && paragraph.include?(%(<pic:cNvPr descr="data:image/png;base64,))
      paragraph = reset_docx_paragraph_indent(set_docx_paragraph_style(paragraph, "MatterQRCode"))
      paragraph = paragraph.sub("</w:pPr>", "<w:keepLines/></w:pPr>")
      paragraph.gsub(/<(?:wp:extent|a:ext)\b[^>]*\/>/) do |extent|
        extent.gsub(/cx="\d+"/, 'cx="685800"').gsub(/cy="\d+"/, 'cy="685800"')
      end
    else
      paragraph
    end
  end
end

# Populate the native Word TOC so ebook links work without a desktop field update.
def add_docx_ebook_toc(xml)
  return xml unless xml.include?("DOCX_TOC_INSERT")

  bookmark_id = next_docx_bookmark_id(xml)
  entries = []
  manuscript = xml[/<w:bookmarkStart w:id="(\d+)" w:name="#{DOCX_MANUSCRIPT_BOOKMARK}"\/>.*?<w:bookmarkEnd w:id="\1"\/>/m].to_s
  has_parts = manuscript.match?(/<w:pStyle\s+w:val="Heading1"/)
  heading_styles = %w[Heading1 Heading2 AboutAuthorHeading OtherBooksHeading1 FrontmatterHeading1 FrontmatterHeading2]
  xml = xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
    style = paragraph[/<w:pStyle\s+w:val="([^"]+)"/, 1]
    next paragraph unless heading_styles.include?(style)

    label = paragraph.scan(/<w:t\b[^>]*>(.*?)<\/w:t>/m).flatten.join
    next paragraph if label.empty?
    anchor = "ebook_section_#{bookmark_id}"
    level = (style == "Heading2" && has_parts) || style == "FrontmatterHeading2" ? 1 : 0
    entries << [anchor, label, level]
    paragraph = reset_docx_paragraph_indent(paragraph)
    paragraph = paragraph.gsub(/<w:outlineLvl\b[^>]*\/>/, '')
    paragraph = paragraph.sub('</w:pPr>', %(<w:outlineLvl w:val="#{level}"/></w:pPr>))
    paragraph = paragraph.sub('</w:pPr>', %(</w:pPr><w:bookmarkStart w:id="#{bookmark_id}" w:name="#{anchor}"/>))
    paragraph = paragraph.sub('</w:p>', %(<w:bookmarkEnd w:id="#{bookmark_id}"/></w:p>))
    bookmark_id += 1
    paragraph
  end
  return xml if entries.empty?

  heading = %(<w:p><w:pPr><w:pStyle w:val="FrontmatterHeading1"/><w:ind w:left="0" w:firstLine="0"/><w:outlineLvl w:val="9"/></w:pPr><w:bookmarkStart w:id="#{bookmark_id}" w:name="toc"/><w:r><w:t>Contents</w:t></w:r><w:bookmarkEnd w:id="#{bookmark_id}"/></w:p>)
  field_start = '<w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> TOC \\o "1-2" \\h \\z \\n \\u </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r>'
  rows = entries.each_with_index.map do |(anchor, label, level), idx|
    start = idx.zero? ? field_start : ''
    finish = idx == entries.size - 1 ? '<w:r><w:fldChar w:fldCharType="end"/></w:r>' : ''
    %(<w:p><w:pPr><w:pStyle w:val="Normal"/><w:ind w:left="#{level * 360}" w:firstLine="0"/><w:spacing w:before="0" w:after="120"/><w:outlineLvl w:val="9"/></w:pPr>#{start}<w:hyperlink w:anchor="#{anchor}"><w:r><w:rPr><w:u w:val="single"/></w:rPr><w:t>#{label}</w:t></w:r></w:hyperlink>#{finish}</w:p>)
  end.join
  toc = %(<w:sdt><w:sdtPr><w:docPartObj><w:docPartGallery w:val="Table of Contents"/><w:docPartUnique/></w:docPartObj></w:sdtPr><w:sdtContent>#{heading}#{rows}</w:sdtContent></w:sdt>)
  xml.sub(/<w:p\b(?:(?!<\/w:p>).)*DOCX_TOC_INSERT.*?<\/w:p>/m) do |placeholder|
    toc + (placeholder.include?('w:type="page"') ? docx_page_break_paragraph : "")
  end
end

def extract_docx_table_of_contents_block(xml)
  toc_block = xml[/<w:sdt\b.*?<w:docPartGallery\s+w:val="Table of Contents"\s*\/?>.*?<\/w:sdt>/m]
  return [xml, ""] unless toc_block

  [xml.sub(toc_block, ""), toc_block]
end

def scope_docx_toc_to_manuscript_bookmark(toc_block)
  return toc_block if toc_block.empty? || toc_block.include?("\\b #{DOCX_MANUSCRIPT_BOOKMARK}")

  toc_block.sub(/TOC ((?:(?!<\/w:instrText>).)*)/m) do
    "TOC #{$1} \\b #{DOCX_MANUSCRIPT_BOOKMARK}"
  end
end

def mark_docx_fields_for_update(zip, enabled = true)
  entry = zip.find_entry("word/settings.xml")
  return unless entry

  settings_xml = entry.get_input_stream.read
  return if enabled && settings_xml.include?("<w:updateFields")

  settings_xml = settings_xml.gsub(/<w:updateFields\b[^>]*\/>/, "")
  settings_xml = settings_xml.sub("</w:settings>", %(<w:updateFields w:val="#{enabled}"/></w:settings>))
  zip.get_output_stream("word/settings.xml") { |f| f.write(settings_xml) }
end

def docx_document_relationship_ids(zip)
  entry = zip.find_entry("word/_rels/document.xml.rels")
  return {} unless entry

  rels_xml = entry.get_input_stream.read
  {
    "rIdHeader1" => rels_xml[/Id="([^"]+)"[^>]*Target="header1\.xml"/, 1],
    "rIdFooterOdd" => rels_xml[/Id="([^"]+)"[^>]*Target="footer1\.xml"/, 1],
    "rIdFooterEven" => rels_xml[/Id="([^"]+)"[^>]*Target="footer2\.xml"/, 1]
  }.compact
end

def remap_docx_section_relationship_ids(xml, zip)
  docx_document_relationship_ids(zip).reduce(xml) do |out, (placeholder, actual)|
    out.gsub(%(r:id="#{placeholder}"), %(r:id="#{actual}"))
  end
end

def enforce_docx_document_settings(zip, config)
  entry = zip.find_entry("word/settings.xml")
  return unless entry

  styles = load_docx_styles(docx_styles_file(config))
  page = styles.fetch("page", {})
  settings_xml = entry.get_input_stream.read
  additions = []
  additions << "<w:mirrorMargins/>" if page.fetch("mirror_margins", false) && !settings_xml.include?("<w:mirrorMargins")
  additions << %(<w:autoHyphenation w:val="true"/>) if page.fetch("auto_hyphenation", false) && !settings_xml.include?("<w:autoHyphenation")
  additions << "<w:evenAndOddHeaders/>" if page.fetch("even_odd_headers", false) && !settings_xml.include?("<w:evenAndOddHeaders")
  return if additions.empty?

  settings_xml = settings_xml.sub("</w:settings>", additions.join + "</w:settings>")
  zip.get_output_stream("word/settings.xml") { |f| f.write(settings_xml) }
end

def enforce_docx_character_styles(zip, config)
  entry = zip.find_entry("word/styles.xml")
  return unless entry

  styles = load_docx_styles(docx_styles_file(config))
  character_styles = styles["character_styles"] || {}
  return if character_styles.empty?

  xml = entry.get_input_stream.read
  character_styles.each_key do |style_id|
    escaped_id = Regexp.escape(CGI.escapeHTML(style_id.to_s))
    xml.gsub!(/<w:style\b(?=[^>]*w:type="character")(?=[^>]*w:styleId="#{escaped_id}")[\s\S]*?<\/w:style>/, "")
  end
  xml = xml.sub("</w:styles>", "#{docx_character_styles_xml(styles)}</w:styles>")
  zip.remove(entry)
  zip.get_output_stream("word/styles.xml") { |f| f.write(xml) }
end

def executable_in_path(*names)
  names.each do |name|
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
      path = File.join(dir, name)
      return path if File.executable?(path) && !File.directory?(path)
    end
  end
  nil
end

def libreoffice_refresh_script
  <<~PY
    import os
    import sys
    import time
    import uno

    from com.sun.star.beans import PropertyValue

    docx_path = os.path.abspath(sys.argv[1])
    port = sys.argv[2]

    def prop(name, value):
        p = PropertyValue()
        p.Name = name
        p.Value = value
        return p

    def insert_native_toc(document):
        descriptor = document.createSearchDescriptor()
        descriptor.SearchString = "DOCX_TOC_INSERT"
        found = document.findFirst(descriptor)
        if found is None:
            return

        toc = document.createInstance("com.sun.star.text.ContentIndex")
        toc.CreateFromOutline = True
        toc.CreateFromMarks = False
        toc.CreateFromLevelParagraphStyles = False
        toc.Level = 3
        toc.Title = "Contents"

        found.getText().insertTextContent(found, toc, True)
        toc.update()

        paragraph_styles = document.StyleFamilies.getByName("ParagraphStyles")
        for style_name in ("Contents 1", "Contents 2", "Contents 3"):
            if paragraph_styles.hasByName(style_name):
                paragraph_styles.getByName(style_name).ParaBottomMargin = 71

    local_ctx = uno.getComponentContext()
    resolver = local_ctx.ServiceManager.createInstanceWithContext(
        "com.sun.star.bridge.UnoUrlResolver",
        local_ctx,
    )

    last_error = None
    ctx = None
    for _ in range(12):
        try:
            ctx = resolver.resolve(
                "uno:socket,host=127.0.0.1,port=%s;urp;StarOffice.ComponentContext" % port
            )
            break
        except Exception as exc:
            last_error = exc
            time.sleep(0.25)

    if ctx is None:
        raise RuntimeError("could not connect to LibreOffice: %s" % last_error)

    desktop = ctx.ServiceManager.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
    url = uno.systemPathToFileUrl(docx_path)
    load_attempts = [
        (
            prop("Hidden", True),
            prop("ReadOnly", False),
            prop("UpdateDocMode", 3),
        ),
        (
            prop("Hidden", True),
            prop("ReadOnly", False),
            prop("UpdateDocMode", 3),
            prop("FilterName", "Office Open XML Text"),
        ),
        (
            prop("Hidden", True),
            prop("ReadOnly", False),
            prop("UpdateDocMode", 3),
            prop("FilterName", "MS Word 2007 XML"),
        ),
        (
            prop("Hidden", True),
            prop("ReadOnly", False),
            prop("UpdateDocMode", 3),
            prop("FilterName", "Office Open XML Text Template"),
        ),
    ]

    document = None
    for args in load_attempts:
        document = desktop.loadComponentFromURL(url, "_blank", 0, args)
        if document is not None:
            break

    if document is None:
        raise RuntimeError("LibreOffice could not open %s" % docx_path)

    try:
        insert_native_toc(document)

        try:
            indexes = document.getDocumentIndexes()
            for idx in range(indexes.getCount()):
                indexes.getByIndex(idx).update()
        except Exception:
            pass

        try:
            fields = document.getTextFields().createEnumeration()
            while fields.hasMoreElements():
                field = fields.nextElement()
                if hasattr(field, "update"):
                    field.update()
        except Exception:
            pass

        refreshed_path = docx_path + ".toc-refresh.docx"
        refreshed_url = uno.systemPathToFileUrl(refreshed_path)
        document.storeToURL(
            refreshed_url,
            (
                prop("FilterName", "Office Open XML Text"),
                prop("Overwrite", True),
            ),
        )
    finally:
        document.close(True)

    if os.path.exists(refreshed_path):
        os.replace(refreshed_path, docx_path)
  PY
end

def refresh_docx_fields_with_libreoffice(docx_file)
  libreoffice = executable_in_path("libreoffice", "soffice")
  python = File.executable?("/usr/bin/python3") ? "/usr/bin/python3" : executable_in_path("python3")
  return false unless libreoffice && python

  profile_dir = Dir.mktmpdir("rakefile-libreoffice-profile")
  cache_dir = Dir.mktmpdir("rakefile-libreoffice-cache")
  script = Tempfile.new(["rakefile-refresh-docx-fields", ".py"])
  port = (20_000 + rand(20_000)).to_s
  accept = "socket,host=127.0.0.1,port=#{port};urp;StarOffice.ServiceManager"
  env = {
    "HOME" => profile_dir,
    "XDG_CONFIG_HOME" => File.join(profile_dir, "config"),
    "XDG_CACHE_HOME" => cache_dir,
    "XDG_RUNTIME_DIR" => File.join(profile_dir, "runtime")
  }

  begin
    FileUtils.mkdir_p(env["XDG_RUNTIME_DIR"])
    File.chmod(0700, env["XDG_RUNTIME_DIR"])
    script.write(libreoffice_refresh_script)
    script.close
    profile_uri = "file://#{File.join(profile_dir, "profile")}"
    pid = spawn(
      env,
      libreoffice,
      "-env:UserInstallation=#{profile_uri}",
      "--headless",
      "--invisible",
      "--nologo",
      "--nodefault",
      "--nofirststartwizard",
      "--accept=#{accept}",
      :out => File::NULL,
      :err => File::NULL
    )

    success = system(env, python, script.path, File.expand_path(docx_file), port, :out => File::NULL, :err => File::NULL)
    success
  rescue
    false
  ensure
    begin
      Process.kill("TERM", pid) if pid
      Process.wait(pid) if pid
    rescue
    end
    script.close! if script
    FileUtils.remove_entry(profile_dir) if profile_dir && Dir.exist?(profile_dir)
    FileUtils.remove_entry(cache_dir) if cache_dir && Dir.exist?(cache_dir)
  end
end

def convert_docx_to_pdf_with_libreoffice(docx_file, pdf_file)
  libreoffice = executable_in_path("libreoffice", "soffice")
  return false unless libreoffice

  profile_dir = Dir.mktmpdir("rakefile-libreoffice-profile")
  cache_dir = Dir.mktmpdir("rakefile-libreoffice-cache")
  docx_path = File.expand_path(docx_file)
  pdf_path = File.expand_path(pdf_file)
  outdir = File.dirname(pdf_path)
  env = {
    "HOME" => profile_dir,
    "XDG_CONFIG_HOME" => File.join(profile_dir, "config"),
    "XDG_CACHE_HOME" => cache_dir,
    "XDG_RUNTIME_DIR" => File.join(profile_dir, "runtime"),
    "SAL_USE_VCLPLUGIN" => "svp"
  }

  begin
    FileUtils.mkdir_p(env["XDG_RUNTIME_DIR"])
    File.chmod(0700, env["XDG_RUNTIME_DIR"])
    FileUtils.rm_f(pdf_path)
    profile_uri = "file://#{File.join(profile_dir, "profile")}"
    success = system(
      env,
      libreoffice,
      "-env:UserInstallation=#{profile_uri}",
      "--headless",
      "--invisible",
      "--nologo",
      "--nodefault",
      "--nofirststartwizard",
      "--nolockcheck",
      "--norestore",
      "--convert-to",
      "pdf",
      "--outdir",
      outdir,
      docx_path
    )
    success && File.exist?(pdf_path)
  ensure
    FileUtils.remove_entry(profile_dir) if profile_dir && Dir.exist?(profile_dir)
    FileUtils.remove_entry(cache_dir) if cache_dir && Dir.exist?(cache_dir)
  end
end

def postprocess_docx_title_page(docx_file, config, interleaved = [])
  require 'zip'

  title = config[:title] || config["title"] || $title
  author = config_author(config)
  title_page = title_page_config(config)
  split_title_page = split_title_page?(config)
  title_text = docx_xml_text_for(title)
  author_text = docx_xml_text_for(author)
  compact_title_page = compact_title_page?(title) || split_title_page
  styles = load_docx_styles(docx_styles_file(config))
  title_page_publisher_style = docx_style(styles, "title_page_publisher")
  page = styles.fetch("page")
  matter_width = docx_inches_to_twips(page.fetch("width_inches") - page.fetch("margin_left_inches") - page.fetch("margin_right_inches"))
  # Start the short publisher block near 78% so its center sits around 80% down the page.
  copyright_top = docx_inches_to_twips(page.fetch("height_inches") * 0.78)
  page_break_sentinel = "PROGRESS_TOOL_DOCX_PAGE_BREAK_SENTINEL"

  Zip::File.open(docx_file) do |zip|
    entry = zip.find_entry("word/document.xml")
    return unless entry

    xml = entry.get_input_stream.read
    title_count = 0
    author_done = author.nil? || author.to_s.strip == ""
    half_title_page = false
    half_series_done = false
    half_conjunction_done = title_page_value_lines(title_page["conjunction"]).empty?
    half_book_done = false
    full_title_page = false
    split_series_done = false
    split_conjunction_done = title_page_value_lines(title_page["conjunction"]).empty?
    split_book_done = false
    split_publisher_paragraphs = 0
    half_title_verso = false
    other_books_catalog_frame = false
    about_author = false
    reader_actions = false
    stay_connected = false
    copyright_page = false
    copyright_publisher = false
    dedication = false

    xml = xml.gsub(/<w:p\b.*?<\/w:p>/m) do |paragraph|
      if paragraph.include?("DOCX_HALF_TITLE_START")
        half_title_page = true
        ""
      elsif split_title_page && half_title_page && !half_series_done && docx_paragraph_contains_title_value?(paragraph, title_page["series_title"])
        half_series_done = true
        paragraph = set_docx_paragraph_style(paragraph, "HalfTitleSeriesTitle")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph
      elsif split_title_page && half_title_page && !half_conjunction_done && docx_paragraph_contains_title_value?(paragraph, title_page["conjunction"])
        half_conjunction_done = true
        paragraph = set_docx_paragraph_style(paragraph, "HalfTitleConjunction")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph
      elsif split_title_page && half_title_page && !half_book_done && docx_paragraph_contains_title_value?(paragraph, title_page["book_title"])
        half_book_done = true
        paragraph = set_docx_paragraph_style(paragraph, "HalfTitleBookTitle")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph
      elsif paragraph.include?('w:name="story-title"')
        center_docx_paragraph(reset_docx_paragraph_indent(paragraph))
      elsif paragraph.include?("DOCX_TITLE_PAGE_START")
        full_title_page = true
        ""
      elsif split_title_page && full_title_page && !split_series_done && docx_paragraph_contains_title_value?(paragraph, title_page["series_title"])
        split_series_done = true
        paragraph = set_docx_paragraph_style(paragraph, "TitlePageSeriesTitle")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph
      elsif split_title_page && full_title_page && !split_conjunction_done && docx_paragraph_contains_title_value?(paragraph, title_page["conjunction"])
        split_conjunction_done = true
        paragraph = set_docx_paragraph_style(paragraph, "TitlePageConjunction")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph
      elsif split_title_page && full_title_page && !split_book_done && docx_paragraph_contains_title_value?(paragraph, title_page["book_title"])
        split_book_done = true
        paragraph = set_docx_paragraph_style(paragraph, "TitlePageBookTitle")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph
      elsif (half_title_page || full_title_page) && !split_title_page && title_count < 2 && paragraph.include?(title_text)
        title_count += 1
        paragraph = set_docx_paragraph_style(paragraph, "TitlePageTitle")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 1.0, after_inches: 0) if full_title_page && compact_title_page
        paragraph
      elsif full_title_page && !author_done && paragraph.include?(author_text)
        author_done = true
        paragraph = set_docx_paragraph_style(paragraph, split_title_page ? "TitlePageSplitAuthor" : "TitlePageAuthor")
        paragraph = center_docx_paragraph(paragraph)
        paragraph = reset_docx_paragraph_indent(paragraph)
        paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
        paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0.15, after_inches: 0.9) if split_title_page
        paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0.45, after_inches: 0.2) if compact_title_page && !split_title_page
        paragraph
      else
        if paragraph.include?("DOCX_HALF_TITLE_VERSO_START")
          half_title_verso = true
          ""
        elsif paragraph.include?("DOCX_HALF_TITLE_VERSO_END")
          half_title_verso = false
          # Keep the next page break outside the anchored catalog block.
          other_books_catalog_frame ? '<w:p><w:pPr><w:spacing w:before="0" w:after="0"/></w:pPr></w:p>' : ""
        elsif paragraph.include?("DOCX_ABOUT_AUTHOR_START")
          about_author = true
          reader_actions = paragraph.include?("DOCX_ABOUT_AUTHOR_START_READER_ACTIONS")
          ""
        elsif paragraph.include?("DOCX_ABOUT_AUTHOR_END")
          about_author = false
          ""
        elsif paragraph.include?("DOCX_STAY_CONNECTED_START")
          stay_connected = true
          ""
        elsif paragraph.include?("DOCX_STAY_CONNECTED_END")
          stay_connected = false
          ""
        elsif paragraph.include?("DOCX_COPYRIGHT_START")
          copyright_page = true
          ""
        elsif paragraph.include?("DOCX_COPYRIGHT_END")
          copyright_page = false
          # Keep the following page break outside the positioned publisher frame.
          '<w:p><w:pPr><w:spacing w:before="0" w:after="0"/></w:pPr></w:p>'
        elsif paragraph.include?("DOCX_COPYRIGHT_PUBLISHER_START")
          copyright_publisher = true
          ""
        elsif paragraph.include?("DOCX_COPYRIGHT_PUBLISHER_END")
          copyright_publisher = false
          ""
        elsif paragraph.include?("DOCX_DEDICATION_START")
          dedication = true
          ""
        elsif paragraph.include?("DOCX_DEDICATION_END")
          dedication = false
          ""
        elsif paragraph.include?("DOCX_TITLE_PAGE_BREAK")
          full_title_page = false
          if paragraph.include?("<w:drawing") || paragraph.include?("<pic:pic")
            remove_docx_paragraph_section_properties(remove_docx_marker_runs(paragraph, "DOCX_TITLE_PAGE_BREAK")) + docx_title_section_break_paragraph(config)
          else
            docx_title_section_break_paragraph(config)
          end
        elsif paragraph.include?("DOCX_FRONTMATTER_PAGE_BREAK_") ||
             paragraph.include?("DOCX_HALF_TITLE_PAGE_BREAK") ||
             paragraph.include?("DOCX_HALF_TITLE_VERSO_PAGE_BREAK") ||
             paragraph.include?("DOCX_TOC_PAGE_BREAK") ||
             paragraph.include?("DOCX_TOC_AFTER_PAGE_BREAK") ||
             paragraph.include?("DOCX_PUBLISHER_PAGE_BREAK") ||
             paragraph.include?("DOCX_COPYRIGHT_PAGE_BREAK") ||
             paragraph.include?("DOCX_DEDICATION_PAGE_BREAK") ||
             paragraph.include?("DOCX_ABOUT_AUTHOR_PAGE_BREAK") ||
             paragraph.include?("DOCX_STAY_CONNECTED_PAGE_BREAK") ||
             paragraph.include?("DOCX_AFTERMATTER_PAGE_BREAK_") ||
             paragraph.include?("DOCX_ACT_PAGE_BREAK") ||
             paragraph.include?("DOCX_CHAPTER_PAGE_BREAK")
          half_title_page = false if paragraph.include?("DOCX_HALF_TITLE_PAGE_BREAK")
          page_break_sentinel
        elsif half_title_verso
          catalog_block = paragraph.include?('w:val="OtherBooksCatalog"')
          paragraph = remove_docx_paragraph_numbering(paragraph)
          paragraph = if paragraph.match?(/<w:pStyle\s+w:val="Heading1"/)
            set_docx_paragraph_style(paragraph, "OtherBooksHeading1")
          elsif paragraph.match?(/<w:pStyle\s+w:val="Heading2"/)
            set_docx_paragraph_style(paragraph, "OtherBooksHeading2")
          else
            set_docx_paragraph_style(paragraph, "OtherBooksTitle")
          end
          paragraph = center_docx_paragraph(paragraph)
          paragraph = reset_docx_paragraph_indent(paragraph)
          paragraph = italicize_docx_paragraph_runs(paragraph) if paragraph.include?(%(<w:pStyle w:val="OtherBooksTitle"/>))
          if catalog_block
            other_books_catalog_frame = true
            paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0, after_inches: 0)
            frame = %(<w:framePr w:w="#{matter_width}" w:hRule="auto" w:hAnchor="margin" w:vAnchor="margin" w:xAlign="center" w:yAlign="bottom" w:wrap="around" w:vSpace="360"/>)
            paragraph = paragraph.sub('</w:pPr>', "#{frame}</w:pPr>")
          end
          paragraph
        elsif about_author
          paragraph = if paragraph.match?(/<w:pStyle\s+w:val="Heading1"/)
            paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0.15, after_inches: 0.1) if reader_actions
            set_docx_paragraph_style(paragraph, "AboutAuthorHeading")
          elsif reader_actions && paragraph.match?(/<w:pStyle\s+w:val="Heading2"/)
            paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0.15, after_inches: 0.1)
            set_docx_paragraph_style(paragraph, "ReaderActionHeading")
          else
            set_docx_paragraph_style(paragraph, "AboutAuthorBody")
          end
          paragraph = reset_docx_paragraph_indent(paragraph)
          paragraph
        elsif stay_connected
          paragraph = if paragraph.match?(/<w:pStyle\s+w:val="Heading1"/)
            set_docx_paragraph_style(paragraph, "AboutAuthorHeading")
          else
            set_docx_paragraph_style(paragraph, "AboutAuthorBody")
          end
          paragraph = reset_docx_paragraph_indent(paragraph)
          paragraph
        elsif copyright_page
          revision_heading = paragraph.include?('w:val="CopyrightRevisionHeading"')
          revision_history = paragraph.include?('w:val="CopyrightRevisionHistory"')
          style = if copyright_publisher
            "CopyrightPublisher"
          elsif paragraph.include?(title_text.upcase)
            "CopyrightTitle"
          else
            "CopyrightBody"
          end
          paragraph = set_docx_paragraph_style(paragraph, style)
          paragraph = reset_docx_paragraph_indent(paragraph)
          if copyright_publisher
            frame = %(<w:framePr w:w="#{matter_width}" w:hRule="auto" w:hAnchor="margin" w:vAnchor="page" w:xAlign="center" w:y="#{copyright_top}" w:wrap="around" w:vSpace="144"/>)
            paragraph = paragraph.sub('</w:pPr>', "#{frame}</w:pPr>")
          elsif revision_heading
            paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0, after_inches: 0)
            paragraph = paragraph.sub('</w:pPr>', '<w:keepNext/></w:pPr>')
          elsif revision_history
            paragraph = paragraph.sub('<w:ind w:left="0"', '<w:ind w:left="360"')
          end
          paragraph
        elsif dedication
          paragraph = set_docx_paragraph_style(paragraph, "Dedication")
          paragraph = center_docx_paragraph(paragraph)
          paragraph = reset_docx_paragraph_indent(paragraph)
          suppress_docx_paragraph_auto_hyphenation(paragraph)
        elsif full_title_page
          paragraph = center_docx_paragraph(paragraph)
          paragraph = reset_docx_paragraph_indent(paragraph)
          paragraph = suppress_docx_paragraph_auto_hyphenation(paragraph)
          if split_title_page
            paragraph = set_docx_paragraph_style(paragraph, "TitlePagePublisher")
            before = if paragraph.include?("<w:drawing") || paragraph.include?("<pic:pic")
              0.55
            elsif split_publisher_paragraphs == 0
              title_page_publisher_style.fetch("spacing_before_inches", 0)
            else
              0
            end
            split_publisher_paragraphs += 1
            paragraph = set_docx_paragraph_spacing(paragraph, before_inches: before, after_inches: 0)
          elsif compact_title_page
            paragraph = set_docx_paragraph_spacing(paragraph, before_inches: 0, after_inches: 0)
          end
          paragraph
        else
          paragraph
        end
      end
    end

    xml = xml.gsub(%r{#{Regexp.escape(page_break_sentinel)}\s*(?=<w:p\b(?:(?!</w:p>).)*DOCX_MANUSCRIPT_START)}m, "")
    xml = xml.gsub(%r{</w:p>\s*#{Regexp.escape(page_break_sentinel)}}m) do |match|
      match.sub("</w:p>", %(<w:r><w:br w:type="page"/></w:r></w:p>)).sub(page_break_sentinel, "")
    end
    xml = xml.gsub(page_break_sentinel, docx_page_break_paragraph)

    xml = style_docx_headings_before_manuscript(xml)
    xml = style_docx_timeline_frontmatter_regions(xml)
    xml = style_docx_dramatis_frontmatter_regions(xml, config)
    xml = style_docx_matter_qr_codes(xml)
    xml = replace_docx_manuscript_boundary_markers(xml, config)
    xml = add_docx_ebook_toc(xml) if ebook_toc?(config)
    xml = replace_docx_endnote_page_markers(xml)
    xml = replace_final_docx_section(xml, docx_body_section_xml(config))
    xml = remap_docx_section_relationship_ids(xml, zip)
    zip.get_output_stream("word/document.xml") { |f| f.write(xml) }
    enforce_docx_character_styles(zip, config)
    enforce_docx_document_settings(zip, config)
    mark_docx_fields_for_update(zip, !ebook_toc?(config))
  end

  # LibreOffice rebuilds ebook TOCs with page numbers and drops the toc bookmark.
  # Ebook contents are already populated; leave them intact for Kindle conversion.
  if !ebook_toc?(config) && ENV["RAKEFILE_SKIP_DOCX_TOC_REFRESH"] != "1" && !refresh_docx_fields_with_libreoffice(docx_file)
    warn "*** WARNING: Could not refresh DOCX table of contents fields with LibreOffice; open the DOCX and update fields if page numbers are stale"
  end
end

desc "Interleave chapters from all source files and write to <title>_draft_<N>.html"
task :interleave_html do
  require 'cgi'

  result = build_interleaved_chapters_for_targets(config)
  all_data = result[:all_data]
  max_chapter = result[:max_chapter]
  pragma_registry = result[:pragma_registry]
  interleaved = result[:interleaved]
  output_html = format_interleaved_as_html(interleaved, config)
  output_file = draft_output_file(config, "html")

  File.open(output_file, "w") do |f|
    f.write(output_html)
  end

  puts "Wrote interleaved chapters to #{output_file}"
  print_interleave_summary(max_chapter)
  print_pragma_output_validation(interleaved, pragma_registry, all_data)
end

desc "Interleave chapters from all source files and write to <title>_draft_<N>.docx"
task :interleave_doc do
  require 'cgi'

  result = build_interleaved_chapters_for_targets(config)
  all_data = result[:all_data]
  max_chapter = result[:max_chapter]
  pragma_registry = result[:pragma_registry]
  interleaved = docx_include_review_notes?(config) ? result[:interleaved] : without_review_notes(result[:interleaved])
  output_html = format_interleaved_as_html(interleaved, config, true, true, true)

  # Write HTML to temporary file
  html_file = draft_output_file(config, "html")
  File.open(html_file, "w") do |f|
    f.write(output_html)
  end

  puts "Wrote interleaved chapters to #{html_file}"
  
  # Convert HTML to DOCX using pandoc (preserves heading hierarchy)
  docx_file = draft_output_file(config, "docx")
  refresh_default_docx_reference_if_needed(config)
  convert_html_to_docx_pandoc(html_file, docx_file, config, true)
  postprocess_docx_title_page(docx_file, config, interleaved)
  
  puts "Converted to #{docx_file}"
  print_interleave_summary(max_chapter)
  print_pragma_output_validation(interleaved, pragma_registry, all_data)
end

desc "Interleave chapters from all source files and write to <title>_draft_<N>.pdf"
task :interleave_pdf => :interleave_doc do
  docx_file = draft_output_file(config, "docx")
  pdf_file = draft_output_file(config, "pdf")

  unless convert_docx_to_pdf_with_libreoffice(docx_file, pdf_file)
    abort "*** ERROR: Could not convert #{docx_file} to #{pdf_file} with LibreOffice"
  end

  puts "Converted to #{pdf_file}"
end

# Alias: interleave_text does the same as interleave_txt
task :interleave_text => :interleave_txt

# Short aliases for interleave tasks
task :it => :interleave_text
task :ih => :interleave_html
task :id => :interleave_doc
task :doc => :interleave_doc
task :docx => :interleave_doc
task :ip => :interleave_pdf
task :pdf => :interleave_pdf
