def stringify_yaml_keys(value)
  case value
  when Hash
    value.each_with_object({}) { |(key, val), out| out[key.to_s.sub(/\A:/, "")] = stringify_yaml_keys(val) }
  when Array
    value.map { |item| stringify_yaml_keys(item) }
  else
    value
  end
end

def deep_merge_hashes(base, override)
  base.merge(override) do |_key, old_val, new_val|
    old_val.is_a?(Hash) && new_val.is_a?(Hash) ? deep_merge_hashes(old_val, new_val) : new_val
  end
end

def docx_styles_file(config = {})
  config[:docx_styles] || config["docx_styles"] || ".docx_styles.yaml"
end

def create_default_docx_styles_yaml(path, overwrite = false)
  return if File.exist?(path) && !overwrite

  File.write(path, default_docx_styles.to_yaml)
end

def load_docx_styles(path = ".docx_styles.yaml")
  styles = default_docx_styles
  if path && File.exist?(path)
    loaded = YAML.load_file(path) || {}
    styles = deep_merge_hashes(styles, stringify_yaml_keys(loaded))
  end
  styles
end

def docx_style(styles, name)
  styles.fetch("styles", {}).fetch(name, {})
end

def docx_points_to_half_points(points)
  (points.to_f * 2).round
end

def docx_points_to_twips(points)
  (points.to_f * 20).round
end

def docx_inches_to_twips(inches)
  (inches.to_f * 1440).round
end

def docx_line_spacing_twips(style)
  case style["line_spacing"].to_s
  when "double"
    480
  when "single"
    240
  when "1.5"
    360
  else
    return docx_points_to_twips(style["line_spacing_points"]) if style.key?("line_spacing_points")

    480
  end
end

def docx_spacing_twips(style, key)
  inches_key = "#{key}_inches"
  points_key = "#{key}_points"
  return docx_inches_to_twips(style[inches_key]) if style.key?(inches_key)
  return docx_points_to_twips(style[points_key]) if style.key?(points_key)

  nil
end

def docx_align_xml(style)
  align = style["align"]
  return "" if align.nil? || align.to_s.strip == ""

  %(<w:jc w:val="#{CGI.escapeHTML(align.to_s)}"/>)
end

def docx_first_line_indent_xml(style)
  has_first_line = style.key?("first_line_indent_inches")
  has_left = style.key?("left_indent_inches")
  return "" unless has_first_line || has_left

  attributes = []
  attributes << %(w:left="#{docx_inches_to_twips(style["left_indent_inches"])}") if has_left
  if has_first_line
    first_line = docx_inches_to_twips(style["first_line_indent_inches"])
    attributes << (first_line < 0 ? %(w:hanging="#{-first_line}") : %(w:firstLine="#{first_line}"))
  elsif has_left
    attributes << %(w:firstLine="0")
  end

  %(<w:ind #{attributes.join(" ")}/>)
end

def docx_tab_stop_xml(style)
  return "" unless style.key?("tab_stop_inches")

  %(<w:tabs><w:tab w:val="left" w:pos="#{docx_inches_to_twips(style["tab_stop_inches"])}"/></w:tabs>)
end

def docx_bold_xml(style)
  return "" unless style["bold"]

  "<w:b/>\n          <w:bCs/>"
end

def docx_italic_xml(style)
  return "" unless style["italic"]

  "<w:i/>\n          <w:iCs/>"
end

def docx_suppress_auto_hyphenation_xml(style)
  style["suppress_auto_hyphenation"] ? "<w:suppressAutoHyphens/>" : ""
end

def docx_paragraph_style_xml(style_id, name, style, styles, based_on: "Normal", next_style: "Normal", default: false, outline_level: nil, keep_next: false)
  font = CGI.escapeHTML(styles["font"].to_s)
  color = CGI.escapeHTML(styles["color"].to_s)
  size = docx_points_to_half_points(style["size"])
  after = docx_spacing_twips(style, "spacing_after") || 0
  before = docx_spacing_twips(style, "spacing_before") || 0
  line = docx_line_spacing_twips(style)
  default_attr = default ? %( w:default="1") : ""
  outline_xml = outline_level.nil? ? "" : %(<w:outlineLvl w:val="#{outline_level}"/>)
  keep_next_xml = keep_next ? "<w:keepNext/>" : ""

  <<~XML
    <w:style w:type="paragraph"#{default_attr} w:styleId="#{CGI.escapeHTML(style_id.to_s)}">
      <w:name w:val="#{CGI.escapeHTML(name.to_s)}"/>
      <w:basedOn w:val="#{CGI.escapeHTML(based_on.to_s)}"/>
      <w:next w:val="#{CGI.escapeHTML(next_style.to_s)}"/>
      <w:qFormat/>
      <w:pPr>
        #{keep_next_xml}
        #{docx_align_xml(style)}
        #{docx_first_line_indent_xml(style)}
        #{docx_tab_stop_xml(style)}
        #{docx_suppress_auto_hyphenation_xml(style)}
        <w:spacing w:before="#{before}" w:after="#{after}" w:line="#{line}" w:lineRule="auto"/>
        #{outline_xml}
      </w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="#{font}" w:hAnsi="#{font}" w:eastAsia="#{font}" w:cs="#{font}"/>
          #{docx_bold_xml(style)}
          #{docx_italic_xml(style)}
          <w:color w:val="#{color}"/>
          <w:sz w:val="#{size}"/>
        <w:szCs w:val="#{size}"/>
      </w:rPr>
    </w:style>
  XML
end

def docx_character_styles_xml(styles)
  (styles["character_styles"] || {}).map do |style_id, style|
    font = CGI.escapeHTML((style["font"] || styles["font"]).to_s)
    id = CGI.escapeHTML(style_id.to_s)
    name = CGI.escapeHTML((style["name"] || style_id).to_s)
    <<~XML
      <w:style w:type="character" w:customStyle="1" w:styleId="#{id}">
        <w:name w:val="#{name}"/>
        <w:basedOn w:val="DefaultParagraphFont"/>
        <w:rPr>
          <w:rFonts w:ascii="#{font}" w:hAnsi="#{font}" w:eastAsia="#{font}" w:cs="#{font}"/>
        </w:rPr>
      </w:style>
    XML
  end.join
end

def docx_page_numbers_enabled?(styles)
  page_numbers = styles.fetch("page_numbers", {})
  page_numbers.fetch("enabled", false)
end

def docx_page_numbers_in_header?(styles)
  docx_page_numbers_enabled?(styles) && styles.fetch("page_numbers", {}).fetch("position", "header").to_s == "header"
end

def docx_page_numbers_in_footer?(styles)
  docx_page_numbers_enabled?(styles) && styles.fetch("page_numbers", {}).fetch("position", "footer").to_s == "footer"
end

def docx_section_xml(styles)
  page = styles.fetch("page", {})
  page_width = docx_inches_to_twips(page.fetch("width_inches", 6))
  page_height = docx_inches_to_twips(page.fetch("height_inches", 9))
  top = docx_inches_to_twips(page.fetch("margin_top_inches", 1))
  right = docx_inches_to_twips(page.fetch("margin_right_inches", 1))
  bottom = docx_inches_to_twips(page.fetch("margin_bottom_inches", 1))
  left = docx_inches_to_twips(page.fetch("margin_left_inches", 1))
  header = docx_inches_to_twips(page.fetch("header_margin_inches", 0.5))
  footer = docx_inches_to_twips(page.fetch("footer_margin_inches", 0.5))
  header_reference = docx_page_numbers_in_header?(styles) ? %(<w:headerReference w:type="default" r:id="rIdHeader1"/>) : ""
  footer_reference = if docx_page_numbers_in_footer?(styles)
    %(<w:footerReference w:type="default" r:id="rIdFooterOdd"/><w:footerReference w:type="even" r:id="rIdFooterEven"/>)
  else
    ""
  end

  <<~XML
    <w:sectPr>
      #{header_reference}
      #{footer_reference}
      <w:pgSz w:w="#{page_width}" w:h="#{page_height}"/>
      <w:pgMar w:top="#{top}" w:right="#{right}" w:bottom="#{bottom}" w:left="#{left}" w:header="#{header}" w:footer="#{footer}" w:gutter="0"/>
    </w:sectPr>
  XML
end

def default_reference_footer_xml(styles = default_docx_styles, align = "right")
  font = CGI.escapeHTML(styles["font"].to_s)
  normal_size = docx_points_to_half_points(docx_style(styles, "normal")["size"])

  <<~XML
    <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <w:ftr xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
      <w:p>
        <w:pPr>
          <w:spacing w:before="0" w:after="58"/>
          <w:jc w:val="#{CGI.escapeHTML(align.to_s)}"/>
        </w:pPr>
        <w:r>
          <w:rPr>
            <w:rFonts w:ascii="#{font}" w:hAnsi="#{font}" w:eastAsia="#{font}" w:cs="#{font}"/>
            <w:sz w:val="#{normal_size}"/>
            <w:szCs w:val="#{normal_size}"/>
          </w:rPr>
          <w:fldChar w:fldCharType="begin"/>
        </w:r>
        <w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r>
        <w:r><w:fldChar w:fldCharType="end"/></w:r>
      </w:p>
    </w:ftr>
  XML
end

def default_reference_header_xml(styles = default_docx_styles)
  page_numbers = styles.fetch("page_numbers", {})
  align = CGI.escapeHTML(page_numbers.fetch("align", "right").to_s)
  font = CGI.escapeHTML(styles["font"].to_s)
  normal_size = docx_points_to_half_points(docx_style(styles, "normal")["size"])

  <<~XML
    <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <w:hdr xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
      <w:p>
        <w:pPr><w:jc w:val="#{align}"/></w:pPr>
        <w:r>
          <w:rPr>
            <w:rFonts w:ascii="#{font}" w:hAnsi="#{font}" w:eastAsia="#{font}" w:cs="#{font}"/>
            <w:sz w:val="#{normal_size}"/>
            <w:szCs w:val="#{normal_size}"/>
          </w:rPr>
          <w:fldChar w:fldCharType="begin"/>
        </w:r>
        <w:r><w:instrText xml:space="preserve">PAGE</w:instrText></w:r>
        <w:r><w:fldChar w:fldCharType="end"/></w:r>
      </w:p>
    </w:hdr>
  XML
end

