  normal_after = docx_spacing_twips(normal, "spacing_after") || 160
  normal_line = docx_line_spacing_twips(normal)
  heading_1_size = docx_points_to_half_points(heading_1["size"])
  heading_1_before = docx_spacing_twips(heading_1, "spacing_before") || 240
  heading_1_after = docx_spacing_twips(heading_1, "spacing_after") || 120
  heading_2_size = docx_points_to_half_points(heading_2["size"])
  heading_2_before = docx_spacing_twips(heading_2, "spacing_before") || 200
  heading_2_after = docx_spacing_twips(heading_2, "spacing_after") || 100
